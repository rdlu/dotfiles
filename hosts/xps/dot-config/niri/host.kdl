// xps display layout — external on top, laptop below, horizontally centered.
// eDP-1 is 1920x1200 at scale 1.0, so 1920x1200 logical; the external is
// 2560x1600 at scale 1.5, so 1706.67x1066.67 logical (reported as 1706x1066).
// x=107 ((1920 - 1706) / 2) centers it over the laptop, and y=1067 puts the
// laptop right under its bottom edge — 1066 overlaps by the fraction and niri
// shoves the laptop off to the right. Rearrange with monitor-tui (F7 or the
// power menu's "Monitor layout"): its ctrl-s rewrites the output blocks here.

output "eDP-1" {
  variable-refresh-rate
  position x=0 y=1067
  scale 1.0
  transform "normal"
}

output "Invalid Vendor Codename - RTK HG540T40 0x01010101" {
  focus-at-startup
  variable-refresh-rate
  position x=107 y=0
  scale 1.5
  transform "normal"
}
