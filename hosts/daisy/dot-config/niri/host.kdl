// daisy display layout — carried over unchanged from the old shared
// outputs.kdl, back when outputs were not yet per-host. No positions here:
// niri lays the outputs out itself, which is what daisy has always done.

output "Invalid Vendor Codename - RTK HG540T40 0x01010101" {
  focus-at-startup
  scale 1.5
  variable-refresh-rate
}

