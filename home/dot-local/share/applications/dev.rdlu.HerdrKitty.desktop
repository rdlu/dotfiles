[Desktop Entry]
Name=Herdr (kitty)
GenericName=Terminal Multiplexer
Comment=Kitty running the herdr multiplexer, ghostty-matched look via herdr.conf
Exec=kitty --config /home/rdlu/.config/kitty/herdr.conf --app-id dev.rdlu.HerdrKitty --title Herdr mise exec -- herdr
