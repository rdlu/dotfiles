#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

&caps_word {
    continue-list = <UNDERSCORE MINUS BACKSPACE DELETE N1 N2 N3 N4 N5 N6 N7 N8 N9 N0 EQUAL SEMICOLON COMMA PERIOD BACKSLASH GRAVE LEFT_BRACKET RIGHT_BRACKET APOSTROPHE SLASH>;
};

/ {
    // Runtime sensor-rotate (cormoran / DYA Studio): the encoder behaviour is
    // editable live from the web UI. rsr_vol = default volume on the first
    // sensor; the transparent rsr_trans (2nd sensor) is provided by the
    // <behaviors/runtime-sensor-rotate.dtsi> include. Used on every layer.
    rsr_vol: rsr_vol {
        compatible = "zmk,behavior-runtime-sensor-rotate";
        #sensor-binding-cells = <0>;
        tap-ms = <5>;
        cw-binding = <&kp C_VOL_UP>;
        ccw-binding = <&kp C_VOL_DN>;
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <230>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <7 8 9 10 11 12 20 21 22 23 24 25 28 29 30 33 34 35 36 37 38 46 47 48 49 50 51 58 59 60 61 62 63>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <230>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 6 13 14 15 16 17 18 19 26 27 28 29 30 31 32 34 35 36 39 40 41 42 43 44 45 52 53 54 55 56 57>;
            hold-trigger-on-release;
        };

        // Index-finger variants: shorter require-prior-idle-ms because the
        // index finger rolls and holds inconsistently, and hold-preferred
        // so the Shift commits on press of the next key (not its release),
        // which eliminates the CamelCase sluggishness that `balanced` has.
        // Safe here because the positional restriction blocks same-hand rolls
        // and the 70 ms idle window blocks in-stream mis-fires.
        hml_idx: home_row_mod_left_index {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            require-prior-idle-ms = <70>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <7 8 9 10 11 12 20 21 22 23 24 25 28 29 30 33 34 35 36 37 38 46 47 48 49 50 51 58 59 60 61 62 63>;
            hold-trigger-on-release;
        };

        hmr_idx: home_row_mod_right_index {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            require-prior-idle-ms = <70>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 6 13 14 15 16 17 18 19 26 27 28 29 30 31 32 34 35 36 39 40 41 42 43 44 45 52 53 54 55 56 57>;
            hold-trigger-on-release;
        };

        ralt_mt: ralt_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <230>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            // No hold-trigger-key-positions: AltGr combos target both hands
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };

        combo_pipe_op {
            bindings = <&M_PIPE>;
            key-positions = <39 49>;
            timeout-ms = <80>;
            layers = <0>;
        };

        // Exit any game layer back to BASE. Top corners (pos 0 + 12) are
        // physically far apart — impossible to brush during gameplay, easy to
        // hit deliberately. Scoped to the game layers only.
        combo_game_exit {
            bindings = <&GAME_EXIT>;
            key-positions = <0 12>;
            timeout-ms = <50>;
            layers = <6 7 8 9>;
        };

        // Re-open the picker without bouncing through BASE.
        combo_game_repick {
            bindings = <&to 5>;
            key-positions = <0 5>;
            timeout-ms = <50>;
            layers = <6 7 8 9>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };

        M_PIPE: M_PIPE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp PIPE &kp GT>;
            label = "PIPE_OP";
        };

        M_DCOLON: M_DCOLON {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp COLON &kp COLON>;
            label = "DBL_COLON";
        };

        M_ARROW: M_ARROW {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp MINUS &kp GT>;
            label = "ARROW";
        };

        M_FARROW: M_FARROW {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "FAT_ARROW";
        };

        M_LARROW: M_LARROW {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp LT &kp MINUS>;
            label = "LEFT_ARROW";
        };

        M_CLOSURE: M_CLOSURE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp PIPE &kp UNDER &kp PIPE>;
            label = "RUST_CLOSURE";
        };

        M_EQEQ: M_EQEQ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp EQUAL &kp EQUAL>;
            label = "EQ_EQ";
        };

        M_NEQ: M_NEQ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp EXCL &kp EQUAL>;
            label = "NOT_EQ";
        };

        M_LEQ: M_LEQ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp LT &kp EQUAL>;
            label = "LESS_EQ";
        };

        M_GEQ: M_GEQ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp GT &kp EQUAL>;
            label = "GTR_EQ";
        };

        M_CONCAT: M_CONCAT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp LT &kp GT>;
            label = "ELX_CONCAT";
        };

        M_PAREN: M_PAREN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "PAREN_PAIR";
        };

        M_BRKT: M_BRKT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
            label = "BRACKET_PAIR";
        };

        M_BRACE: M_BRACE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
            label = "BRACE_PAIR";
        };

        M_DQUO: M_DQUO {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp DQT &kp DQT &kp LEFT>;
            label = "DQT_PAIR";
        };

        M_SIGS: M_SIGS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp TILDE &kp S &kp LPAR &kp RPAR &kp LEFT>;
            label = "SIGIL_S";
        };

        M_SIGW: M_SIGW {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp TILDE &kp W &kp LPAR &kp RPAR &kp LEFT>;
            label = "SIGIL_W";
        };

        M_SIGR: M_SIGR {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp TILDE &kp R &kp FSLH &kp FSLH &kp LEFT>;
            label = "SIGIL_R";
        };

        M_SIGD: M_SIGD {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp TILDE &kp LS(D) &kp LBKT &kp RBKT &kp LEFT>;
            label = "SIGIL_D";
        };

        M_TFISH: M_TFISH {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp COLON &kp COLON &kp LT &kp GT &kp LEFT>;
            label = "TURBOFISH";
        };

        M_DBG: M_DBG {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp D &kp B &kp G &kp EXCL &kp LPAR &kp RPAR &kp LEFT>;
            label = "RUST_DBG";
        };

        M_TODO: M_TODO {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp T &kp O &kp D &kp O &kp EXCL &kp LPAR &kp RPAR &kp LEFT>;
            label = "RUST_TODO";
        };

        M_HEEXI: M_HEEXI {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp LBRC &kp SPACE &kp SPACE &kp RBRC &kp LEFT &kp LEFT>;
            label = "HEEX_INTERP";
        };

        M_HEEXNP: M_HEEXNP {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp LT &kp PRCNT &kp SPACE &kp SPACE &kp PRCNT &kp GT &kp LEFT &kp LEFT &kp LEFT>;
            label = "EEX_NONPRINT";
        };

        // Magic SysRq: on Linux PrintScreen *is* KEY_SYSRQ (HID SysReq, 0x9A,
        // maps to nothing), and the kernel takes it as SysRq while Alt is down.
        // Alt stays held until this key is released, so: hold SYS, press and
        // keep holding this key, let go of SYS, tap the command letter on BASE
        // (R E I S U B, ...). Which commands work is kernel.sysrq's bitmask.
        SYSRQ: SYSRQ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp PSCRN>, <&macro_pause_for_release>, <&macro_release &kp LALT>;
            label = "SYSRQ";
        };

        // Game-mode entry macros: enable RGB underglow, set a solid per-game
        // color, then activate the matching layer. The color shows on USB and
        // on battery alike (CONFIG_ZMK_RGB_UNDERGLOW_AUTO_OFF_USB=n since
        // v2.6.0); the OLED display-name ("MINECRFT" / "GAME" / "NOMANSKY" /
        // "MYGAME") is still the primary active-mode cue.
        GAME_MC_TO: GAME_MC_TO {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_ON>, <&rgb_ug RGB_EFS_CMD 0>, <&rgb_ug RGB_COLOR_HSB(120,100,50)>, <&to 6>;
            label = "GAME_MC_TO";
        };

        GAME_GEN_TO: GAME_GEN_TO {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_ON>, <&rgb_ug RGB_EFS_CMD 0>, <&rgb_ug RGB_COLOR_HSB(220,100,50)>, <&to 7>;
            label = "GAME_GEN_TO";
        };

        GAME_NMS_TO: GAME_NMS_TO {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_ON>, <&rgb_ug RGB_EFS_CMD 0>, <&rgb_ug RGB_COLOR_HSB(0,0,50)>, <&to 8>;
            label = "GAME_NMS_TO";
        };

        // MYGAME (custom slot, #79): yellow, hue 60 — the one wide gap left in
        // the wheel (amber 35 MEDIA, green 120 MC, teal 160 base, blue 220 GAME).
        GAME_MY_TO: GAME_MY_TO {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_ON>, <&rgb_ug RGB_EFS_CMD 0>, <&rgb_ug RGB_COLOR_HSB(60,100,50)>, <&to 9>;
            label = "GAME_MY_TO";
        };

        // Exit: turn the underglow off (smart-off base = dark) and return to BASE.
        GAME_EXIT: GAME_EXIT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_OFF>, <&to 0>;
            label = "GAME_EXIT";
        };

        // Per-layer RGB feedback now lives in the zmk-rgb-layer module
        // (event-driven listener on layer-state changes), not in the keymap.
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp GRAVE   &kp N1  &kp N2   &kp N3        &kp N4        &kp N5             &kp C_VOL_UP     &kp N6           &kp N7        &kp N8        &kp N9   &kp N0      &kp MINUS
&kp TAB     &kp Q   &kp W          &kp E         &kp R            &kp T              &kp C_VOL_DN     &kp Y            &kp U            &kp I         &kp O           &kp P       &kp EQUAL
&kp ESC     &kp A   &hml LALT S    &hml LCTRL D  &hml_idx LSHFT F &kp G              &kp C_PP         &kp H            &hmr_idx RSHFT J &hmr RCTRL K  &hmr LALT L     &kp SEMI    &kp APOS
&kp BSLH    &kp Z   &kp X    &kp C         &kp V         &kp B              &kp C_NEXT       &kp N            &kp M         &kp COMMA     &kp DOT  &kp FSLH    &kp RET
&kp C_MUTE  &mo 4   &kp F11  &kp LGUI      &mo 1         &kp BSPC           &kp C_MUTE       &kp SPACE        &mo 2         &caps_word    &ralt_mt RALT F12  &mo 3
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "BASE";
        };

        layer_1 {
            bindings = <
&kp F12        &kp F1         &kp F2             &kp F3             &kp F4     &kp F5      &kp UP_ARROW     &kp F6      &kp F7     &kp F8     &kp F9      &kp F10        &kp F11
&kp LG(U)      &kp LG(I)      &trans             &trans             &trans     &kp LC(PSCRN)  &kp DOWN_ARROW   &kp HOME    &kp PG_DN  &kp PG_UP  &kp END     &kp INS        &kp PRINTSCREEN
&kp LG(LS(H))  &kp LG(LS(J))  &hml LALT LG(LS(K))  &hml LCTRL LG(LS(L))  &trans     &kp LA(PSCRN)  &kp LEFT_ARROW   &kp LEFT    &kp DOWN   &kp UP     &kp RIGHT   &kp DEL        &kp PAUSE_BREAK
&kp LG(LC(U))  &kp LG(LC(I))  &kp LG(LS(LC(H)))  &kp LG(LS(LC(L)))  &trans     &kp LS(PSCRN)  &kp RIGHT_ARROW  &kp LG(N1)  &kp LG(U)  &kp LG(I)  &kp LG(N9)  &kp LG(LS(H))  &kp LG(LS(L))
&trans         &trans         &trans             &trans             &trans     &kp DEL     &kp ENTER        &kp K_APP   &kp LCTRL  &kp LEFT   &kp RIGHT   &trans
            >;

            display-name = "NAV";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_2 {
            bindings = <
&trans     &M_SIGS    &M_SIGW        &M_SIGR         &M_SIGD         &M_CONCAT   &trans  &trans     &M_HEEXI  &M_HEEXNP  &trans      &trans     &trans
&trans     &trans     &M_LARROW      &M_PIPE         &M_ARROW        &M_FARROW   &trans  &M_DCOLON  &M_CLOSURE &M_DBG    &M_TODO     &M_TFISH   &trans
&kp GRAVE  &kp LBRC   &mt LALT RBRC  &mt LCTRL LBKT  &mt LSHFT RBKT  &kp PLUS    &trans  &M_PAREN   &M_BRKT   &M_BRACE   &M_DQUO     &trans     &trans
&trans     &kp MINUS  &kp UNDER      &kp LPAR        &kp RPAR        &kp EQUAL   &trans  &M_EQEQ    &M_NEQ    &M_LEQ     &M_GEQ      &trans     &trans
&trans     &trans     &trans         &trans          &trans          &kp DEL     &trans  &trans     &trans    &trans     &trans      &trans
            >;

            display-name = "CODE";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_3 {
            bindings = <
&kp F14  &kp F15  &kp F16  &kp F17  &kp F18  &kp F19    &kp C_VOL_UP  &trans        &trans        &trans      &trans      &trans  &trans
&trans  &trans  &kp LG(C_BRI_UP)  &kp C_BRI_UP  &trans  &kp F24    &kp C_VOL_DN  &trans        &trans        &trans      &trans      &trans  &trans
&trans  &trans  &kp LG(C_BRI_DN)  &kp C_BRI_DN  &kp DEL  &trans   &kp C_PP      &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PP    &kp C_STOP  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &kp F21   &kp C_NEXT    &kp F20       &kp C_MUTE    &kp C_PREV  &kp C_NEXT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp C_MUTE    &trans        &trans        &trans      &trans      &trans
            >;

            display-name = "MEDIA";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_4 {
            bindings = <
&bt BT_CLR       &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3  &bt BT_SEL 4    &mmv MOVE_UP     &kp KP_NUM       &kp KP_N7  &kp KP_N8  &kp KP_N9   &kp KP_MINUS  &kp C_AL_CALC
&none            &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_EFF  &mkp MB4      &mkp MB5        &mmv MOVE_DOWN   &kp KP_SLASH     &kp KP_N4  &kp KP_N5  &kp KP_N6   &kp KP_PLUS   &SYSRQ
&none            &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_EFR  &mkp LCLK     &mkp RCLK       &mmv MOVE_LEFT   &kp KP_ASTERISK  &kp KP_N1  &kp KP_N2  &kp KP_N3   &kp KP_ENTER  &trans
&rgb_ug RGB_TOG  &none            &none            &none            &mkp MCLK     &kp LG(LA(L))          &mmv MOVE_RIGHT  &kp KP_EQUAL     &kp KP_N0  &kp COMMA  &kp KP_DOT  &kp PERCENT   &trans
&trans           &trans           &trans           &trans           &trans        &trans          &mkp LCLK        &trans           &trans     &trans     &trans      &to 5
            >;

            display-name = "SYS|NUM";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        // Layer 5 — GAME_PICK: transient launcher reached from the SYS layer
        // (hold left-thumb SYS, tap right-thumb outer key → &to 5). Joystick
        // UP = Minecraft, DOWN = generic GAME, LEFT = No Man's Sky,
        // RIGHT = MYGAME (custom slot), CENTER = cancel back to BASE. Every
        // other key is &none so a stray press can't escape the picker.
        layer_5 {
            bindings = <
&none  &none  &none  &none  &none  &none      &GAME_MC_TO   &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &GAME_GEN_TO  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &GAME_NMS_TO  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &GAME_MY_TO   &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &to 0         &none  &none  &none  &none  &none
            >;

            display-name = "GAME?";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        // Layer 6 — GAME_MC (Minecraft). Plain WASD/QWER, no HRM. LCTRL@39
        // sprint, LSHIFT@56 sneak, SPACE@57 + @59 on both thumbs. Right half plain
        // QWERTY for chat. Joystick = 4-way audio cluster. F13@62 = push-to-talk
        // for Discord/in-game voice. F3@0 = debug screen.
        layer_6 {
            bindings = <
&kp F3      &kp N1  &kp N2  &kp N3    &kp N4     &kp N5         &kp C_VOL_UP  &kp N6     &kp N7    &kp N8     &kp N9    &kp N0     &kp MINUS
&kp TAB     &kp Q   &kp W   &kp E     &kp R      &kp T          &kp C_VOL_DN  &kp Y      &kp U     &kp I      &kp O     &kp P      &kp EQUAL
&kp ESC     &kp A   &kp S   &kp D     &kp F      &kp G          &kp C_MUTE    &kp H      &kp J     &kp K      &kp L     &kp SEMI   &kp APOS
&kp LCTRL   &kp Z   &kp X   &kp C     &kp V      &kp B          &kp C_PP      &kp N      &kp M     &kp COMMA  &kp DOT   &kp FSLH   &kp RET
&kp C_MUTE  &kp F2  &kp F11 &kp LGUI  &kp LSHFT  &kp SPACE      &kp ENTER     &kp SPACE  &kp BSPC  &kp LALT   &kp F13   &mo 3
            >;

            display-name = "MINECRFT";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        // Layer 7 — GAME (generic FPS/MOBA: LoL / Doom / CS2 / etc.). Same
        // chassis as MC, but GRAVE@0 = console. Default binds live at their
        // natural letter positions (QWER abilities, B/R/E/G actions, 1-6 items).
        layer_7 {
            bindings = <
&kp GRAVE   &kp N1  &kp N2  &kp N3    &kp N4     &kp N5         &kp C_VOL_UP  &kp N6     &kp N7    &kp N8     &kp N9    &kp N0     &kp MINUS
&kp TAB     &kp Q   &kp W   &kp E     &kp R      &kp T          &kp C_VOL_DN  &kp Y      &kp U     &kp I      &kp O     &kp P      &kp EQUAL
&kp ESC     &kp A   &kp S   &kp D     &kp F      &kp G          &kp C_MUTE    &kp H      &kp J     &kp K      &kp L     &kp SEMI   &kp APOS
&kp LCTRL   &kp Z   &kp X   &kp C     &kp V      &kp B          &kp C_PP      &kp N      &kp M     &kp COMMA  &kp DOT   &kp FSLH   &kp RET
&kp C_MUTE  &kp F2  &kp F11 &kp LGUI  &kp LSHFT  &kp SPACE      &kp ENTER     &kp SPACE  &kp BSPC  &kp LALT   &kp F13   &mo 3
            >;

            display-name = "GAME";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        // Layer 8 — NOMANSKY (No Man's Sky). Same chassis as GAME (7), with two
        // deliberate deltas:
        //   * LSHFT@39 / LCTRL@56 are exchanged vs. layers 6-7 — NMS puts run on
        //     Shift and leaves Ctrl unused, and this is the arrangement the
        //     owner asked for. (Note: it does move the held run modifier off the
        //     thumb and onto the pinky, unlike the MC/GAME chassis.)
        //   * pos 0 = F12 (Steam screenshot). MC's F3 debug screen and GAME's
        //     GRAVE console both do nothing in NMS.
        layer_8 {
            bindings = <
&kp F12     &kp N1  &kp N2  &kp N3    &kp N4     &kp N5         &kp C_VOL_UP  &kp N6     &kp N7    &kp N8     &kp N9    &kp N0     &kp MINUS
&kp TAB     &kp Q   &kp W   &kp E     &kp R      &kp T          &kp C_VOL_DN  &kp Y      &kp U     &kp I      &kp O     &kp P      &kp EQUAL
&kp ESC     &kp A   &kp S   &kp D     &kp F      &kp G          &kp C_MUTE    &kp H      &kp J     &kp K      &kp L     &kp SEMI   &kp APOS
&kp LSHFT   &kp Z   &kp X   &kp C     &kp V      &kp B          &kp C_PP      &kp N      &kp M     &kp COMMA  &kp DOT   &kp FSLH   &kp RET
&kp C_MUTE  &kp F2  &kp F11 &kp LGUI  &kp LCTRL  &kp SPACE      &kp ENTER     &kp SPACE  &kp BSPC  &kp LALT   &kp F13   &mo 3
            >;

            display-name = "NOMANSKY";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        // Layer 9 — MYGAME: the owner's custom game slot (#79), picker joystick
        // RIGHT. Starts as a verbatim copy of GAME (7) — same chassis, GRAVE@0 —
        // and is meant to be rebound live (Studio now, sofleii game presets
        // later) without rebuilding the firmware.
        layer_9 {
            bindings = <
&kp GRAVE   &kp N1  &kp N2  &kp N3    &kp N4     &kp N5         &kp C_VOL_UP  &kp N6     &kp N7    &kp N8     &kp N9    &kp N0     &kp MINUS
&kp TAB     &kp Q   &kp W   &kp E     &kp R      &kp T          &kp C_VOL_DN  &kp Y      &kp U     &kp I      &kp O     &kp P      &kp EQUAL
&kp ESC     &kp A   &kp S   &kp D     &kp F      &kp G          &kp C_MUTE    &kp H      &kp J     &kp K      &kp L     &kp SEMI   &kp APOS
&kp LCTRL   &kp Z   &kp X   &kp C     &kp V      &kp B          &kp C_PP      &kp N      &kp M     &kp COMMA  &kp DOT   &kp FSLH   &kp RET
&kp C_MUTE  &kp F2  &kp F11 &kp LGUI  &kp LSHFT  &kp SPACE      &kp ENTER     &kp SPACE  &kp BSPC  &kp LALT   &kp F13   &mo 3
            >;

            display-name = "MYGAME";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
