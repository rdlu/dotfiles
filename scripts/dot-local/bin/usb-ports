#!/bin/bash
# Show every physical USB port: what's plugged in and at what link speed, with
# the USB 2 and USB 3 halves of each port side by side — so a port that has
# silently fallen back to USB 2 (its SuperSpeed lanes dead, which on USB-C also
# means no DisplayPort alt mode) stands out. Then the USB-C/PD state and which
# DP/HDMI connectors are lit, power, and a health verdict built from the
# checks that diagnosed daisy's dead USB-C port on 2026-09-27.
#
#   usb-ports        # full report + health; exit 1 if anything is wrong
#   usb-ports -H     # health verdict only
#   usb-ports -w     # full report, refreshed every second (plug/unplug and watch;
#                    # skips the firmware section, which doesn't change that fast)
#
# The kernel can't tell which socket on the chassis a root port is, so labels
# come from ~/.config/usb-ports/labels (per host, stowed from hosts/<host>/):
#   <pci-address>-<port>  <label>      e.g.  0000:06:00.4-1  USB-C (caps lock)
# Find the key for a socket by plugging something in and reading the
# unlabeled line it appears on. A UCSI port gets the same label via
#   typec:<portN>  <label>             e.g.  typec:port0  USB-C (caps lock)
# (plug something into the socket, see which portN gains a partner), so a
# device that carries no USB data — a monitor in DP alt mode — still shows
# on its socket. Firmware that fwupd lists only as "UEFI Device Firmware" gets
# a name the same way, by its ESRT GUID:
#   esrt:<guid>  <label>               e.g.  esrt:a77b326c-…  USB-C PD firmware
# The USB 2 and USB 3 halves of a socket are paired by the kernel's `peer`
# link when firmware describes it (daisy). Where it doesn't (the XPS 9320's
# Thunderbolt ports have none), pair them by hand, USB 2 key → USB 3 key:
#   peer:<usb2-key>  <usb3-key>        e.g.  peer:0000:00:14.0-1  0000:00:0d.0-1
# (plug a USB 3 device in; the USB 3 key is its SuperSpeed root port's
# <pci-address>-<port>, which matches the USB 2 one by port number on Intel).
#
# Thunderbolt/USB4 domains, when present, get their own section: security
# level and each attached device's authorization and link speed.
#
# Firmware: BIOS/EC from DMI, fwupd's pending updates (cached metadata, no
# network) and failed attempts. On Lenovo machines it also compares BIOS and
# labelled PD firmware against Lenovo's per-model update catalog — the only
# source for them, since LVFS doesn't carry these models. On Dell machines it
# compares BIOS against Dell's catalog for the system ID (DMI product_sku),
# which gets releases before LVFS does (needs bsdtar or cabextract). Catalogs
# are fetched at most once a day into ~/.cache/usb-ports/.
set -euo pipefail

labels_file="${XDG_CONFIG_HOME:-$HOME/.config}/usb-ports/labels"

if [[ -t 1 ]]; then
  B=$'\e[1m' D=$'\e[2m' R=$'\e[31m' G=$'\e[32m' Y=$'\e[33m' N=$'\e[0m'
else
  B='' D='' R='' G='' Y='' N=''
fi

declare -A label=()
if [[ -r $labels_file ]]; then
  while read -r key text; do
    [[ -z $key || $key == \#* ]] && continue
    label[$key]=$text
  done <"$labels_file"
fi

rd() { cat "$1" 2>/dev/null || true; }

# Health findings, filled in while the sections print.
findings=() bad=0
ok() { findings+=("  ${G}✓$N $*"); }
warn() { findings+=("  ${Y}⚠$N $*"); bad=1; }
fail() { findings+=("  ${R}✗$N $*"); bad=1; }

speed() {
  case "$1" in
    1.5) echo "1.5M (USB 1 low)" ;;
    12) echo "12M (USB 1 full)" ;;
    480) echo "480M (USB 2)" ;;
    5000) echo "5G (USB 3 Gen 1)" ;;
    10000) echo "10G (USB 3 Gen 2)" ;;
    20000) echo "20G (USB 3 Gen 2x2)" ;;
    *) echo "${1}M" ;;
  esac
}

# Devices under root port <bus>-<port>, indented by hub depth.
tree() {
  local bus=$1 port=$2 d name depth
  for d in /sys/bus/usb/devices/"$bus-$port" /sys/bus/usb/devices/"$bus-$port".*; do
    [[ -e $d/idVendor ]] || continue
    name=${d##*/}
    depth=$(tr -cd . <<<"$name" | wc -c)
    printf '      %*s%s %s:%s  %-22s %s\n' $((depth * 2)) '' "$D└$N" \
      "$(rd "$d/idVendor")" "$(rd "$d/idProduct")" "$(speed "$(rd "$d/speed")")" \
      "$(rd "$d/product")"
  done
}

# SuperSpeed root hub's bus number on PCI controller <pci-address>, for a
# peer: pairing. A controller has one USB 2 and one USB 3 root hub.
ss_bus() {
  local h
  for h in /sys/bus/usb/devices/usb[0-9]*; do
    [[ $(basename "$(readlink -f "$h/..")") == "$1" ]] || continue
    case $(rd "$h/speed") in 5000|10000|20000) echo "${h##*/usb}"; return 0 ;; esac
  done
  return 0
}

# Root port "<bus>-<port>" (either half) → socket label; filled by sections()
# so the kernel log can say which socket a device path is on.
declare -A sock=()

# Socket label for a kernel message naming a USB device ("usb 2-3.1: …") or a
# root port ("usb usb2-port3: …"); empty when unlabelled.
sock_of() {
  local re1='usb ([0-9]+)-([0-9]+)[.:]' re2='usb usb([0-9]+)-port([0-9]+)'
  if [[ $1 =~ $re1 || $1 =~ $re2 ]]; then
    echo "${sock[${BASH_REMATCH[1]}-${BASH_REMATCH[2]}]:-}"
  fi
  return 0
}

snapshot() {
  findings=() bad=0
  { sections; ((${no_fw:-0})) || firmware; } >&3
  health
}

# Latest BIOS/PD versions from Lenovo's update catalog for this machine type,
# as "bios <NN>" / "pd <hex>" lines; cached for a day. Empty when offline.
lenovo_latest() {
  local mtm=$1 cache=${XDG_CACHE_HOME:-$HOME/.cache}/usb-ports/lenovo-$1.txt cat pkg url
  if [[ -s $cache && -n $(find "$cache" -mmin -1440 2>/dev/null) ]]; then
    cat "$cache"; return 0
  fi
  cat=$(curl -fsL --max-time 8 "https://download.lenovo.com/catalog/${mtm}_Win11.xml" 2>/dev/null) || return 0
  mkdir -p "${cache%/*}"
  {
    # BIOS package id ends in the BIOS build number: r2kuj40w -> R2KET40W.
    url=$(awk '/<location>/{l=$0} /<category>BIOS UEFI/{print l; exit}' <<<"$cat" |
      grep -oE 'https://[^<]+' || true)
    [[ $url =~ /([a-z0-9]{3})[a-z]{2}([0-9]{2})w_ ]] && echo "bios ${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
    # PD firmware: the one package whose description says so; its version is hex.
    for url in $(grep -oE 'https://[^<]+[a-z0-9]{3}pd[0-9]{2}w_[^<]*\.xml' <<<"$cat"); do
      pkg=$(curl -fsL --max-time 8 "$url" 2>/dev/null) || continue
      grep -q 'PD Firmware' <<<"$pkg" || continue
      grep -oE '<Version hex2dec="True">[0-9A-Fa-f]+' <<<"$pkg" | head -1 | sed 's/.*>/pd /'
    done
  } >"$cache.tmp" 2>/dev/null || true
  [[ -s $cache.tmp ]] && mv "$cache.tmp" "$cache" && cat "$cache"
  rm -f "$cache.tmp"
  return 0
}

# Latest BIOS in Dell's catalog for this system ID (DMI product_sku), as
# "bios <ver> <date> <package-id> <criticality>"; cached for a day. Empty when
# offline. A subshell, so the EXIT trap cleans up the scratch dir.
dell_latest() (
  local sku=$1 cache=${XDG_CACHE_HOME:-$HOME/.cache}/usb-ports/dell-$1.txt tmp path
  if [[ -s $cache && -n $(find "$cache" -mmin -1440 2>/dev/null) ]]; then
    cat "$cache"; return 0
  fi
  tmp=$(mktemp -d) || return 0
  trap 'rm -rf "$tmp"' EXIT
  # Both cabs hold one UTF-16LE, CRLF XML file.
  unpack() {
    curl -fsL --max-time 15 -o "$tmp/c.cab" "https://downloads.dell.com/$1" 2>/dev/null || return 1
    rm -f "$tmp"/*.xml
    if command -v bsdtar >/dev/null; then
      bsdtar -xf "$tmp/c.cab" -C "$tmp" 2>/dev/null
    else
      cabextract -q -d "$tmp" "$tmp/c.cab" >/dev/null 2>&1
    fi || return 1
    iconv -f UTF-16LE -t UTF-8 "$tmp"/*.xml 2>/dev/null | tr -d '\r'
  }
  # The index maps system ID → per-model cab, whose folder changes per release.
  path=$(unpack catalog/CatalogIndexPC.cab |
    awk -v id="systemID=\"$sku\"" '/<GroupManifest/ { b = "" } { b = b $0 "\n" }
      /<\/GroupManifest>/ && index(b, id) { print b; exit }' |
    grep -oE 'path="[^"]+\.cab"' | head -1 | cut -d'"' -f2 || true)
  [[ -n $path ]] || return 0
  mkdir -p "${cache%/*}"
  # BIOS components aren't in version order; take the highest.
  unpack "$path" | awk '
    function attr(n) { return match($0, n "=\"[^\"]*\"") ? substr($0, RSTART + length(n) + 2, RLENGTH - length(n) - 3) : "" }
    /<SoftwareComponent / { bios = 0; crit = ""; v = attr("vendorVersion"); d = attr("releaseDate"); p = attr("packageID") }
    /<ComponentType value="BIOS"/ { bios = 1 }
    /<Criticality / { c = 1; next }
    c && /<Display/ { crit = $0; sub(/.*CDATA\[/, "", crit); sub(/\]\].*/, "", crit); c = 0 }
    /<\/SoftwareComponent>/ && bios && v != "" { print v "\t" d "\t" p "\t" crit }' |
    sort -t$'\t' -k1,1V | tail -1 | awk -F'\t' '{ print "bios", $1, $2, $3, $4 }' >"$cache.tmp" 2>/dev/null || true
  [[ -s $cache.tmp ]] && mv "$cache.tmp" "$cache" && cat "$cache"
  rm -f "$cache.tmp"
  return 0
)

firmware() {
  echo
  echo "${B}Firmware$N"
  local vendor bios_id bios_rel bios_date ec mtm latest lb lb_prefix lb_nn cur_nn sku dell_upd=''
  vendor=$(rd /sys/class/dmi/id/sys_vendor)
  bios_id=$(rd /sys/class/dmi/id/bios_version); bios_id=${bios_id%% *}
  bios_rel=$(rd /sys/class/dmi/id/bios_release)
  bios_date=$(rd /sys/class/dmi/id/bios_date)
  ec=$(rd /sys/class/dmi/id/ec_firmware_release)
  echo "  BIOS: $bios_id${bios_rel:+ ($bios_rel)}  ${D}$bios_date$N${ec:+  EC: $ec}"

  if [[ $vendor == LENOVO ]]; then
    mtm=$(rd /sys/class/dmi/id/product_name); mtm=${mtm:0:4}
    latest=$(lenovo_latest "$mtm")
    lb=$(awk '$1=="bios"{print $2, $3}' <<<"$latest")
    if [[ -z $latest ]]; then
      echo "  ${D}Lenovo catalog for $mtm unreachable (offline?) — latest versions not checked$N"
    elif [[ -n $lb ]]; then
      lb_prefix=${lb% *}; lb_nn=${lb#* }
      cur_nn=$(grep -oE '[0-9]{2}W$' <<<"$bios_id" | tr -d W || true)
      if [[ ${bios_id,,} != "$lb_prefix"* || -z $cur_nn ]]; then
        echo "  ${D}catalog BIOS package doesn't match this BIOS family — not compared$N"
      elif ((10#$cur_nn >= 10#$lb_nn)); then
        echo "  ${D}latest BIOS in Lenovo's catalog: build $lb_nn — up to date$N"
        ok "BIOS up to date ($bios_id${bios_rel:+, $bios_rel})"
      else
        echo "  ${Y}Lenovo has BIOS build $lb_nn (you have $cur_nn)$N"
        warn "BIOS update available: $bios_id → build $lb_nn. Install from Windows" \
          "(${lb_prefix}uj${lb_nn}w.exe); the bootable ISO flasher fails on this machine"
      fi
    fi
  elif [[ $vendor == "Dell Inc." ]]; then
    sku=$(rd /sys/class/dmi/id/product_sku)
    local re='^bios ([^ ]+) (.+) ([^ ]+) ([^ ]+)$'
    if ! command -v bsdtar >/dev/null && ! command -v cabextract >/dev/null; then
      echo "  ${D}can't read Dell's catalog (install libarchive) — latest versions not checked$N"
    else
      latest=$(dell_latest "$sku")
      if [[ -z $latest ]]; then
        echo "  ${D}Dell catalog for $sku unreachable (offline?) — latest versions not checked$N"
      elif [[ $latest =~ $re ]]; then
        if [[ $(printf '%s\n' "$bios_id" "${BASH_REMATCH[1]}" | sort -V | tail -1) == "$bios_id" ]]; then
          echo "  ${D}latest BIOS in Dell's catalog: ${BASH_REMATCH[1]} — up to date$N"
          ok "BIOS up to date ($bios_id)"
        else
          echo "  ${Y}Dell has BIOS ${BASH_REMATCH[1]} (${BASH_REMATCH[4]}, ${BASH_REMATCH[2]})$N" \
            "${D}https://www.dell.com/support/home/us/en/19/Drivers/DriversDetails?driverId=${BASH_REMATCH[3]}$N"
          # Warned after the fwupd query below, which says whether LVFS has it yet.
          dell_upd="BIOS update available: $bios_id → ${BASH_REMATCH[1]} (${BASH_REMATCH[4]}, ${BASH_REMATCH[2]})"
        fi
      fi
    fi
  fi

  # fwupd: labelled capsule devices, failed attempts, pending updates.
  command -v fwupdmgr >/dev/null && command -v jq >/dev/null || {
    echo "  ${D}fwupd/jq not installed — skipping capsule firmware checks$N"
    [[ -n $dell_upd ]] && warn "$dell_upd — flash from F12 → BIOS Flash Update with the .exe on the ESP"
    return 0; }
  local devs upd g name ver lpd failed=()
  devs=$(fwupdmgr get-devices --json 2>/dev/null || true)
  lpd=$(awk '$1=="pd"{print $2}' <<<"${latest:-}")
  for g in "${!label[@]}"; do
    [[ $g == esrt:* ]] || continue
    ver=$(jq -r --arg g "${g#esrt:}" '.Devices[]? | select((.Guid // []) | index($g)) | .Version' <<<"$devs" | head -1)
    [[ -n $ver ]] || continue
    printf '  %s: %s %s(0x%x)%s\n' "${label[$g]}" "$ver" "$D" "$ver" "$N"
    if [[ -n $lpd && ${label[$g]} == *PD* ]]; then
      if ((ver >= 16#$lpd)); then
        ok "${label[$g]} up to date (0x$(printf %x "$ver"))"
      else
        warn "${label[$g]} update available: 0x$(printf %x "$ver") → 0x$lpd (Windows-only installer)"
      fi
    fi
  done
  # UpdateState 3 = failed, 5 = failed-transient.
  mapfile -t failed < <(jq -r '.Devices[]? | select(.UpdateState == 3 or .UpdateState == 5) | .Name' <<<"$devs")
  ((${#failed[@]})) && fail "fwupd recorded a failed firmware update: ${failed[*]}"
  upd=$(fwupdmgr get-updates --json 2>/dev/null |
    jq -r '.Devices[]? | "\(.Name) \(.Version) → \(.Releases[0].Version)"' 2>/dev/null || true)
  if [[ -n $upd ]]; then
    echo "$upd" | sed "s/^/  ${Y}update:$N /"
    warn "fwupd has $(grep -c . <<<"$upd") firmware update(s): $(paste -sd';' <<<"$upd")" \
      "— fwupdmgr update"
  else
    echo "  ${D}fwupd: no pending updates (cached metadata; fwupdmgr refresh to re-check)$N"
  fi
  if [[ -n $dell_upd ]]; then
    if grep -q '^System Firmware ' <<<"$upd"; then
      warn "$dell_upd — fwupd has it too: fwupdmgr update"
    else
      # Dell's catalog runs ahead of LVFS (2.31.0 wasn't there after a refresh).
      warn "$dell_upd — not on LVFS yet; flash from F12 → BIOS Flash Update with the" \
        ".exe on the ESP, or wait for fwupdmgr"
    fi
  fi
  return 0
}

# External connectors that are lit, as DRM names (DP-2, HDMI-A-1).
lit_connectors() {
  local c
  for c in /sys/class/drm/card*-*; do
    [[ -e $c/status && $c != *eDP* && $c != *Writeback* ]] || continue
    [[ $(rd "$c/status") == connected ]] && echo "${c##*/card[0-9]-}"
  done
  return 0
}

# Thunderbolt/USB4: domain security and each attached device (router). Only
# where the bus exists — daisy's USB-C ports aren't USB4, so no section there.
thunderbolt() {
  local tb=/sys/bus/thunderbolt/devices doms d r n dom sec secs=() unauth=() devs=0 link bolt
  doms=("$tb"/domain[0-9]*)
  [[ -e ${doms[0]} ]] || return 0
  echo
  echo "${B}Thunderbolt / USB4$N"
  for d in "${doms[@]}"; do
    dom=${d##*/domain}
    sec=$(rd "$d/security")
    [[ " ${secs[*]} " == *" ${sec:-?} "* ]] || secs+=("${sec:-?}")
    # The host router (<dom>-0) says which controller this domain is.
    printf '  domain%s  security %s%s  %s%s %s, gen %s%s\n' "$dom" "${sec:-?}" \
      "$([[ $(rd "$d/iommu_dma_protection") == 1 ]] && echo ", IOMMU DMA protection")" \
      "$D" "$(rd "$tb/$dom-0/vendor_name")" "$(rd "$tb/$dom-0/device_name")" \
      "$(rd "$tb/$dom-0/generation")" "$N"
  done
  # Device routers are <dom>-<route>; <dom>-0 is the host, and names with
  # "." or ":" are XDomain services and retimers, not devices.
  for r in "$tb"/[0-9]*-[0-9a-f]*; do
    n=${r##*/}
    [[ -e $r/authorized && $n != *-0 && $n != *[.:]* ]] || continue
    devs=$((devs + 1))
    link=''
    [[ -n $(rd "$r/rx_speed") ]] &&
      link="rx $(rd "$r/rx_speed")×$(rd "$r/rx_lanes")  tx $(rd "$r/tx_speed")×$(rd "$r/tx_lanes")"
    bolt=''
    # boltd's view, if installed: whether the device is enrolled (auto-authorized next time).
    command -v boltctl >/dev/null &&
      bolt=$(boltctl info "$(rd "$r/unique_id")" 2>/dev/null | awk '/stored:/ { print "stored " $NF; exit }' || true)
    printf '  %s  %s %s  %s  gen %s  %s%s%s\n' "$n" "$(rd "$r/vendor_name")" "$(rd "$r/device_name")" \
      "$(case $(rd "$r/authorized") in 0) echo "${Y}not authorized$N" ;; *) echo "${G}authorized$N" ;; esac)" \
      "$(rd "$r/generation")" "$D" "$link${bolt:+  $bolt}" "$N"
    [[ $(rd "$r/authorized") == 0 ]] && unauth+=("$(rd "$r/device_name") ($n)")
  done
  ((devs)) || echo "  ${D}no Thunderbolt/USB4 devices attached$N"
  if ((${#unauth[@]})); then
    warn "Thunderbolt device(s) not authorized, so no PCIe tunnels: ${unauth[*]} —" \
      "boltctl authorize <uuid> (or enroll to make it stick)"
  else
    ok "Thunderbolt/USB4: ${#doms[@]} domain(s), security ${secs[*]}, $devs device(s) attached"
  fi
  return 0
}

sections() {
  echo "${B}USB ports$N"
  local p bus port peer pbus pport pkey pci key hs ss top name ss_seen=0 ss_down=0 t tc lit_dp any_peer=0
  lit_dp=$(lit_connectors | grep '^DP-' | tr '\n' ' ' || true)
  sock=()
  # With peer links on the machine, a port without one is really USB 2-only;
  # with none at all, firmware just doesn't describe them, and the USB 3 half
  # is unknown rather than absent.
  compgen -G '/sys/bus/usb/devices/usb*/*-0:1.0/usb*-port*/peer' >/dev/null && any_peer=1
  for p in /sys/bus/usb/devices/usb*/*-0:1.0/usb*-port*; do
    [[ $(rd "$p/connect_type") == hotplug ]] || continue
    bus=${p##*/usb}; port=${bus#*-port}; bus=${bus%-port*}
    # Visit each physical port once, from its USB 2 (480M root hub) side.
    [[ $(rd "/sys/bus/usb/devices/usb$bus/speed") == 480 ]] || continue
    pci=$(basename "$(readlink -f "/sys/bus/usb/devices/usb$bus/..")")
    key="$pci-$port"
    name=${label[$key]:-$key}
    # readlink -f prints a path even for a missing link, so test it first.
    pbus='' pport=''
    if [[ -e $p/peer ]]; then
      peer=$(readlink -f "$p/peer")
      pbus=${peer##*/usb}; pport=${pbus#*-port}; pbus=${pbus%-port*}
    elif [[ -n ${label[peer:$key]:-} ]]; then
      pkey=${label[peer:$key]%% *}
      pbus=$(ss_bus "${pkey%-*}")
      [[ -n $pbus ]] && pport=${pkey##*-}
    fi
    if [[ -n ${label[$key]:-} ]]; then
      sock[$bus-$port]=${label[$key]}
      [[ -n $pbus ]] && sock[$pbus-$pport]=${label[$key]}
    fi
    hs=0 ss=0
    [[ -e /sys/bus/usb/devices/$bus-$port ]] && hs=1
    [[ -n $pbus && -e /sys/bus/usb/devices/$pbus-$pport ]] && ss=1
    ((ss)) && ss_seen=1

    printf '\n  %s%-20s%s %s%s%s\n' "$B" "${label[$key]:-unlabeled}" "$N" "$D" "$key" "$N"
    if ((ss)); then
      echo "    USB 3 half: ${G}linked$N"
      tree "$pbus" "$pport"
    elif [[ -n $pbus ]]; then
      echo "    USB 3 half: ${D}idle$N"
    elif ((!any_peer)); then
      echo "    USB 3 half: ${Y}unknown$N ${D}(no peer link — add a peer: line)$N"
    fi
    if ((hs)); then
      echo "    USB 2 half: ${G}linked$N"
      tree "$bus" "$port"
    else
      echo "    USB 2 half: ${D}idle$N"
    fi
    # The socket's USB-C side, when the labels file maps a UCSI port to it.
    tc=''
    for t in "${!label[@]}"; do
      [[ $t == typec:* && -n ${label[$key]:-} && ${label[$t]} == "${label[$key]}" ]] && tc=${t#typec:}
    done
    if [[ -n $tc && -d /sys/class/typec/$tc/$tc-partner ]]; then
      echo "    USB-C:      ${G}partner$N ${D}($tc)$N"
      if ((!hs && !ss)); then
        # No USB data but a partner: a display in alt mode, or a bare charger.
        if [[ -n $lit_dp ]]; then
          echo "      ${D}└$N display in DP alt mode → ${G}${lit_dp% }$N"
        else
          echo "      ${D}└$N no USB data, no DisplayPort (charger only?)"
        fi
      fi
    fi
    # A hub on the USB 2 side with nothing on the USB 3 side is a USB 3 hub
    # whose SuperSpeed link never came up (USB 2-only hubs are rare now).
    top=/sys/bus/usb/devices/$bus-$port
    if ((hs && !ss)) && [[ -n $pbus && $(rd "$top/bDeviceClass") == 09 ]]; then
      echo "    ${R}⚠ hub linked at USB 2 only — its USB 3 half is missing$N"
      fail "$name: hub stuck at USB 2 — the port's SuperSpeed lanes are down, so no" \
        "USB 3 and no DP alt mode either. Flip the plug; if that fails, EC reset" \
        "(power off, unplug all, hold power 15 s)"
      ss_down=1
    fi
  done
  ((ss_seen && !ss_down)) && ok "USB 3 links up (SuperSpeed lanes working)"

  echo
  echo "${B}USB-C (UCSI)$N"
  local t n partner psy psys online ports=(/sys/class/typec/port[0-9]) sinks=()
  if [[ ! -e ${ports[0]} ]]; then
    echo "  ${Y}no USB-C ports registered$N"
    ports=()
    fail "USB-C status driver (UCSI) didn't init — Linux can't see USB-C state." \
      "Video still works; fix: pkexec sh -c 'modprobe -r ucsi_acpi && modprobe ucsi_acpi', or reboot"
  else
    ok "USB-C status driver (UCSI) up: ${#ports[@]} port(s)"
  fi
  for t in "${ports[@]}"; do
    n=${t##*/}; partner=$t/$n-partner
    # UCSI names its supply <acpi-dev><1-based connector>: USBC000:00 + 1 → …:001.
    psys=(/sys/class/power_supply/ucsi-source-psy-*:00$((${n#port} + 1)))
    psy=${psys[0]}
    online=$(rd "$psy/online")
    [[ -n ${label[typec:$n]:-} ]] && n+=" (${label[typec:$n]})"
    if [[ -d $partner ]]; then
      printf '  %s: %spartner%s  pd=%s  alt-modes=%s  power-in=%s%s\n' "$n" "$G" "$N" \
        "$(rd "$partner/supports_usb_power_delivery")" \
        "$(rd "$partner/number_of_alternate_modes")" \
        "$([[ $online == 1 ]] && echo "${Y}charging$N" || echo no)" \
        "$([[ -d $t/${t##*/}-cable ]] && echo "  cable=$(rd "$t/${t##*/}-cable/type")")"
      [[ $online == 1 ]] || sinks+=("${t##*/}")
    else
      echo "  $n: ${D}empty$N"
    fi
  done

  thunderbolt

  echo
  echo "${B}Display connectors$N"
  local c conn lit=0 dp=0 hdmi=0 vrr=''
  for c in /sys/class/drm/card*-*; do
    [[ -e $c/status && $c != *eDP* && $c != *Writeback* ]] || continue
    [[ $(rd "$c/status") == connected ]] || continue
    conn=${c##*/card[0-9]-}; lit=1
    case $conn in DP-*) dp=1 ;; HDMI-*) hdmi=1 ;; esac
    # Mode + VRR as niri drives it (niri names outputs by connector).
    if command -v niri >/dev/null && command -v jq >/dev/null; then
      vrr=$(niri msg --json outputs 2>/dev/null | jq -r --arg c "$conn" '
        .[$c] // empty | (.modes[.current_mode] // {}) as $m
        | "\($m.width)x\($m.height)@\(($m.refresh_rate // 0) / 1000)  VRR "
          + (if .vrr_enabled then "on" elif .vrr_supported then "off" else "unsupported" end)
          + "  scale \(.logical.scale // "?")"' 2>/dev/null || true)
    fi
    printf '  %s%s%s connected%s  %s%s%s\n' "$G" "$conn" "$N" \
      "$([[ $conn == DP-* ]] && echo " (USB-C alt mode)")" "$D" "$vrr" "$N"
  done
  ((lit)) || echo "  ${D}no external display connected$N"

  if ((dp)); then
    ok "external display on USB-C (DP alt mode working)"
  elif ((hdmi)); then
    ok "external display on HDMI"
    [[ $vrr == *"VRR on"* ]] &&
      warn "VRR is always-on over HDMI — the RTK portable monitor flickered like this;" \
        "if it does, set 'variable-refresh-rate on-demand=true' on its niri output"
  fi
  # A USB-C partner that isn't feeding us power, with no DP lit: a monitor
  # there means alt mode never came up (the 2026-09-27 failure).
  if ((${#sinks[@]} && !dp)); then
    warn "USB-C device on ${sinks[*]} but no DisplayPort output — if it's a monitor," \
      "alt mode failed: check the cable on another machine, then EC reset"
  fi

  echo
  echo "${B}Power$N"
  local ac cap st end src=() s i v a srcs=''
  ac=$(rd /sys/class/power_supply/AC/online)
  cap=$(rd /sys/class/power_supply/BAT0/capacity)
  st=$(rd /sys/class/power_supply/BAT0/status)
  end=$(rd /sys/class/power_supply/BAT0/charge_control_end_threshold)
  for s in /sys/class/power_supply/ucsi-source-psy-*; do
    [[ $(rd "$s/online") == 1 ]] || continue
    i=port$((10#${s##*:} - 1))
    [[ -n ${label[typec:$i]:-} ]] && i+=" (${label[typec:$i]})"
    # What the PD contract settled on; the partner's supports_usb_power_delivery
    # can say "no" while this still reads 20 V (seen on the XPS's dock).
    v=$(rd "$s/voltage_now") a=$(rd "$s/current_max")
    if [[ $v =~ ^[0-9]+$ && $a =~ ^[0-9]+$ ]] && ((v && a)); then
      i+=" $(awk -v v="$v" -v a="$a" 'BEGIN { printf "%gV %gA ≈ %.0fW", v / 1e6, a / 1e6, v * a / 1e12 }')"
    fi
    src+=("$i")
  done
  ((${#src[@]})) && srcs=$(printf '%s, ' "${src[@]}") && srcs=${srcs%, }
  echo "  AC: $([[ $ac == 1 ]] && echo "${G}online$N" || echo "${Y}offline$N")" \
    "${srcs:+ via USB-C $srcs}  battery: ${cap:-?}% $st${end:+  (charge limit $end%)}"
  if [[ $ac == 1 ]]; then
    if ((${#src[@]})); then
      ok "charging power arriving via USB-C $srcs"
    else
      ok "on AC power (via a port UCSI doesn't report, e.g. a hub's charging pass-through)"
    fi
  fi

  echo
  echo "${B}Kernel log (this boot)$N"
  local log hits benign resets l msg secs where re k per=() n_reset=0
  declare -A nres=()
  # Monotonic timestamps: seconds since boot tell an at-boot failure (a dock
  # enumerating before the TB controller settled) from one while in use.
  log=$(journalctl -k -b -q -p warning --no-pager -o short-monotonic 2>/dev/null || true)
  # Real failures only. amdgpu's LTTPR/REG_WAIT noise shows up on healthy boots.
  hits=$(grep -iE 'ucsi.*(fail|error)|over-current|device descriptor read|not accepting address|unable to enumerate|cannot enable|link training.*fail|HC died|xhci.*error' <<<"$log" || true)
  benign=$(grep -cE 'LTTPR|REG_WAIT' <<<"$log" || true)
  re='^\[ *([0-9]+)\.[0-9]+\] [^ ]+ kernel: (.*)$'
  if [[ -n $hits ]]; then
    tail -n 5 <<<"$hits" | while IFS= read -r l; do
      if [[ $l =~ $re ]]; then
        secs=${BASH_REMATCH[1]} msg=${BASH_REMATCH[2]}
        where=$(sock_of "$msg")
        printf '  %s[%5ss]%s %s%s%s\n' "$D" "$secs" "$N" "${msg:0:120}" \
          "${where:+  ← $where}" "$( ((secs < 60)) && echo " $D(at boot)$N")"
      else
        echo "  ${l:0:160}"
      fi
    done
    fail "$(grep -c . <<<"$hits") USB/USB-C/display error line(s) in the kernel log — see above"
  else
    ((benign)) || benign=''  # grep -c says 0, not nothing — and Intel never has any
    echo "  ${D}no USB, USB-C or link-training errors${benign:+ ($benign benign amdgpu LTTPR/REG_WAIT lines)}$N"
    ok "kernel log clean"
  fi
  # Link resets are info-level, so not in the warnings above. A couple while a
  # dock settles is normal; a steady trickle is a flaky cable or marginal link.
  resets=$(journalctl -k -b -q --no-pager -o short-monotonic 2>/dev/null |
    grep -E 'reset (SuperSpeed|high-speed)' || true)
  if [[ -n $resets ]]; then
    while IFS= read -r l; do
      [[ $l =~ $re ]] || continue
      msg=${BASH_REMATCH[2]}
      where=$(sock_of "$msg")
      [[ -z $where && $msg =~ usb\ ([0-9]+-[0-9]+) ]] && where="port ${BASH_REMATCH[1]}"
      k=${where:-unknown port}
      nres[$k]=$((${nres[$k]:-0} + 1)); n_reset=$((n_reset + 1))
    done <<<"$resets"
    for k in "${!nres[@]}"; do per+=("$k ×${nres[$k]}"); done
    k=$(printf '%s\n' "${per[@]}" | sort | awk 'NR > 1 { printf ", " } { printf "%s", $0 }')
    echo "  ${D}$n_reset USB link reset(s): $k$N"
    ((n_reset >= 5)) &&
      warn "$n_reset USB link resets this boot on $k" \
        "— flaky cable/dock or a marginal SuperSpeed link; reseat or swap the cable"
  fi
  return 0
}

health() {
  echo
  echo "${B}Health$N"
  printf '%s\n' "${findings[@]}"
  ((bad)) && echo "  ${Y}→ something needs a look$N" || echo "  ${G}→ all good$N"
  return "$bad"
}

case "${1:-}" in
  -w|--watch)
    trap 'tput cnorm 2>/dev/null; exit' INT TERM
    tput civis 2>/dev/null || true
    exec 3>&1
    no_fw=1
    while :; do
      out=$(snapshot 3>&1 || true)
      clear
      printf '%s\n\n%s\n' "$out" "${D}refreshing every 1s — ctrl+c to quit$N"
      sleep 1
    done
    ;;
  -H|--health) snapshot 3>/dev/null ;;
  '') snapshot 3>&1 ;;
  *) echo "usage: usb-ports [-H|--health] [-w|--watch]" >&2; exit 2 ;;
esac
