#!/usr/bin/env fish

# theme-tui - fzf picker for the desktop theme (desktop-theme.conf) with live
#             GTK3 / GTK4 / KDE preview windows.
#
# Main view:    every conf key with its current value.
# Option view:  the installed choices for that key (● = the conf's value),
#               from `desktop-theme list --notes KEY`; GTK themes flathub has
#               no org.gtk.Gtk3theme.* extension for show "(no flatpak)":
#               flatpak apps fall back to light Adwaita with them. Trying one
#               never installs an extension; keeping one does.
#
# Option view keys:
#   tab     try: apply the highlighted value temporarily (conf untouched, via
#           `desktop-theme preview`) and relaunch the preview windows. Trying
#           a mode previews its whole bundle (the script's mode defaults).
#   enter   keep: write it to the conf (`desktop-theme set`, or dark|light
#           for mode) and apply
#   ctrl-p  open/close the preview windows without changing anything
#   esc     back; reverts a try (`desktop-theme apply`)
#
# Previews: gtk3-widget-factory, gtk4-widget-factory (pkgs gtk3-demos,
# gtk4-demos) and filelight, launched without the stale GTK_THEME /
# QT_QPA_PLATFORMTHEME. They are relaunched on every try (GTK3 and KDE apps
# don't reload a theme live). Only the PIDs this TUI started are ever killed.
# Leaving the TUI, however it ends, closes them and re-applies the conf.

set -g SELF (status filename)
set -g DOTFILES (set -q DOTFILES; and echo $DOTFILES; or echo $HOME/.dotfiles)
set -g DT (command -v desktop-theme; or echo $DOTFILES/niri/dot-local/bin/desktop-theme)
set -g KEYS mode gtk_theme kde_scheme icon_theme kde_icon_theme cursor_theme cursor_size
set -g PREVIEW_APPS gtk3-widget-factory gtk4-widget-factory filelight

# per-run state dir, exported so the fzf callbacks (`theme-tui __try ...`,
# separate processes) share it: pids, trying, term, log, msg
set -g STATE $THEME_TUI_DIR

function _die
    echo "theme-tui: $argv" >&2
    exit 1
end

function note # last-action line shown in the headers
    echo $argv >$STATE/msg
end

# --- preview windows ---------------------------------------------------------

function previews_running
    test -s $STATE/pids
end

# kill exactly the PIDs we started, and only if they still run what we started
function previews_close
    test -r $STATE/pids; or return 0
    set -l pids
    for line in (cat $STATE/pids)
        set -l f (string split ' ' -- $line)
        test -r /proc/$f[1]/cmdline; or continue
        set -l argv0 (string split0 </proc/$f[1]/cmdline)[1]
        if test (path basename -- "$argv0") = $f[2]
            kill $f[1] 2>/dev/null; and set -a pids $f[1]
        end
    end
    rm -f $STATE/pids
    # wait them out: a lingering GTK app would swallow the relaunch (single
    # instance over D-Bus) and keep showing the old theme
    for i in (seq 30)
        set -l alive
        for p in $pids
            test -d /proc/$p; and set -a alive $p
        end
        set pids $alive
        test (count $pids) -eq 0; and return 0
        sleep 0.1
    end
    kill -9 $pids 2>/dev/null
    return 0
end

function previews_open
    previews_close
    set -l missing
    for app in $PREVIEW_APPS
        if not command -q $app
            set -a missing $app
            continue
        end
        env -u GTK_THEME -u QT_QPA_PLATFORMTHEME $app </dev/null >/dev/null 2>&1 &
        echo "$last_pid $app" >>$STATE/pids
        disown $last_pid 2>/dev/null
    end
    if test (count $missing) -gt 0
        note "preview apps not installed: $missing (pkgs gtk3-demos gtk4-demos filelight)"
    end
    previews_running; or return 0
    # new windows take focus as they map: hand it back to the terminal
    $SELF __refocus (string split -f1 ' ' <$STATE/pids) </dev/null >/dev/null 2>&1 &
    disown $last_pid 2>/dev/null
end

# wait until each pid has a window (or ~8s), then focus the TUI's terminal
function refocus
    set -l term (cat $STATE/term 2>/dev/null)
    test -n "$term"; or return 0
    for i in (seq 40)
        set -l have (niri msg -j windows 2>/dev/null | jq -r '.[].pid')
        set -l all 1
        for p in $argv
            contains -- $p $have; or set all 0
        end
        test $all = 1; and break
        sleep 0.2
    end
    niri msg action focus-window --id $term >/dev/null 2>&1
end

function previews_refresh # relaunch only if they are open
    previews_running; and previews_open
    return 0
end

# --- theme actions -----------------------------------------------------------

function try_value --argument-names key value
    if $DT preview $key $value >$STATE/log 2>&1
        echo "$key=$value" >$STATE/trying
        note "trying $key=$value (not saved)"
    else
        note "preview $key=$value failed (see the preview pane)"
    end
    previews_open
end

function revert
    test -e $STATE/trying; or return 0
    $DT apply >$STATE/log 2>&1
    rm -f $STATE/trying
    note "reverted to the conf"
    previews_refresh
end

function keep --argument-names key value
    if test $key = mode
        $DT $value >$STATE/log 2>&1 # mode + its gtk/kde defaults
    else
        $DT set $key $value >$STATE/log 2>&1
    end
    and note "kept $key=$value (conf written)"
    or note "saving $key=$value failed (see the preview pane)"
    set -l tried (cat $STATE/trying 2>/dev/null)
    rm -f $STATE/trying
    # the previews already show it if that exact value was the one tried
    test "$tried" = "$key=$value"; or previews_refresh
    return 0
end

# --- view line builders (VALUE \t display) -----------------------------------

function main_lines
    for kv in ($DT get)
        set -l f (string split -m1 = -- $kv)
        printf '%s\t%-16s \x1b[36m%s\x1b[0m\n' $f[1] $f[1] $f[2]
    end
end

function option_lines --argument-names key
    set -l cur ($DT get $key)
    set -l tried (string replace -f "$key=" '' -- (cat $STATE/trying 2>/dev/null))
    for line in ($DT list --notes $key)
        set -l f (string split -m1 \t -- $line)
        set -l v $f[1]
        set -l tag
        test -n "$f[2]"; and set tag " \x1b[2m($f[2])\x1b[0m"
        test "$v" = "$tried"; and set tag "$tag"' \x1b[33m(trying)\x1b[0m'
        if test "$v" = "$cur"
            printf "%s\t\x1b[32m●\x1b[0m %s$tag\n" $v $v
        else
            printf "%s\t  %s$tag\n" $v $v
        end
    end
end

# option view preview pane: conf vs live vs highlighted, previews, last output
function state_pane --argument-names key value
    set -l tried (cat $STATE/trying 2>/dev/null)
    set_color --bold; echo $key; set_color normal
    echo "  conf:        "($DT get $key)
    echo "  highlighted: $value"
    if test -n "$tried"
        set_color yellow; echo "  live now:    $tried (tab'd, not saved: esc reverts)"; set_color normal
    else
        echo "  live now:    the conf"
    end
    echo
    if previews_running
        set_color green; echo "previews open:"; set_color normal
        for line in (cat $STATE/pids)
            echo "  $line"
        end
    else
        set_color -d; echo "previews closed (ctrl-p opens them, tab relaunches them)"; set_color normal
    end
    if test -s $STATE/log
        echo
        set_color -d; echo "last desktop-theme output:"; set_color normal
        cat $STATE/log
    end
end

function header --argument-names text
    set -l msg (cat $STATE/msg 2>/dev/null)
    if test -n "$msg"
        printf '%s\n\x1b[2m%s\x1b[0m' $text $msg
    else
        printf '%s' $text
    end
end

# --- views -------------------------------------------------------------------

function option_view --argument-names key
    set -l lines (option_lines $key)
    test (count $lines) -eq 0; and return
    set -l cur ($DT get $key)
    set -l pos 1
    for i in (seq (count $lines))
        test (string split -f1 \t -- $lines[$i]) = "$cur"; and set pos $i
    end
    set -l hdr (header "$key | tab: try | enter: keep | ctrl-p: previews on/off | esc: back (reverts a try)" | string collect)
    set -l sel (printf '%s\n' $lines | fzf --ansi --reverse \
        --delimiter \t --with-nth 2 --track --id-nth 1 \
        --header "$hdr" --prompt "$key> " \
        --bind "load:pos($pos)+unbind(load)" \
        --bind "tab:execute-silent($SELF __try $key {1})+reload($SELF __options $key)+refresh-preview" \
        --bind "ctrl-p:execute-silent($SELF __previews toggle)+refresh-preview" \
        --preview "$SELF __state $key {1}" --preview-window 'right:50%:wrap')
    if test -n "$sel"
        keep $key (string split -f1 \t -- $sel)
    else
        revert
    end
end

function main
    command -q fzf; or _die "fzf is required"
    test -x "$DT"; or _die "desktop-theme not found (stow niri)"
    set -gx THEME_TUI_DIR (mktemp -d (set -q XDG_RUNTIME_DIR; and echo $XDG_RUNTIME_DIR; or echo /tmp)/theme-tui.XXXXXX)
    set -g STATE $THEME_TUI_DIR
    # the terminal we run in, to hand focus back after previews map
    if command -q niri; and command -q jq
        niri msg -j focused-window 2>/dev/null | jq -r '.id // empty' >$STATE/term
    end

    # defined here, not at top level: the fzf callbacks run this same script
    # and must not tear down the shared state when they exit
    function _cleanup --on-event fish_exit
        previews_close
        $DT apply >/dev/null 2>&1
        rm -rf $STATE
    end
    function _on_signal --on-signal INT --on-signal TERM --on-signal HUP
        exit 130
    end

    while true
        set -l hdr (header 'enter: pick a value | ctrl-p: previews on/off | esc: quit' | string collect)
        set -l sel (main_lines | fzf --ansi --reverse \
            --delimiter \t --with-nth 2 \
            --header "$hdr" --prompt 'theme> ' \
            --bind "ctrl-p:execute-silent($SELF __previews toggle)+refresh-preview" \
            --preview "$SELF __options {1} | cut -f2" --preview-window 'right:50%')
        test -z "$sel"; and break
        option_view (string split -f1 \t -- $sel)
    end
    exit 0
end

# --- entrypoint --------------------------------------------------------------

if string match -q '__*' -- "$argv[1]"; and test -z "$STATE"
    _die "$argv[1] is internal (called by fzf inside a running theme-tui)"
end

switch "$argv[1]"
    case ''
        main
    case __try # theme-tui __try KEY VALUE
        try_value $argv[2] $argv[3]
    case __options # theme-tui __options KEY
        option_lines $argv[2]
    case __state # theme-tui __state KEY VALUE
        state_pane $argv[2] $argv[3]
    case __previews # theme-tui __previews toggle|open|close
        switch "$argv[2]"
            case toggle
                if previews_running
                    previews_close
                else
                    previews_open
                end
            case open
                previews_open
            case close
                previews_close
        end
    case __refocus # theme-tui __refocus PID...
        refocus $argv[2..-1]
    case '*'
        _die "unknown argument: $argv[1]"
end
