#!/usr/bin/env fish

# monitor-tui - place, rotate and scale niri outputs, then write the result
#               straight into hosts/<hostname>/dot-config/niri/host.kdl.
#
# Why this exists rather than nwg-displays/monique/kanshi: every one of those
# owns its own generated config file, which then fights the hand-written
# host.kdl for the same outputs -- niri validates the duplicate without a
# word and one side silently wins. This edits host.kdl in place instead, so
# comments, EDID output names and focus-at-startup all survive.
#
# Output view:  every connected output, its logical geometry, scale and
#               transform. The preview pane draws the arrangement to scale.
# Placement:    relative -- "above DP-2", "left of eDP-1" -- then an
#               alignment on the cross axis, centre by default. Exact logical
#               pixels come from the live mode, scale and transform, so there
#               is no hand-derived 1707 to get wrong. The arrangement is then
#               normalised so its top-left corner sits at 0,0.
# Rotation:     the eight niri transforms.
# Scale:        niri's own list, "auto", or a typed factor.
#
# Rotating or rescaling changes an output's logical width and height. Every
# action re-reads from niri, so later placement maths always sees the new
# dimensions -- but outputs already placed around it keep their positions and
# can end up overlapping or gapped. Re-place them and the numbers come right.
#
# On start every output is pinned to where it already is -- no visible
# change, but it stops niri auto-placing the ones you are not moving.
#
# Nothing is written until ctrl-s. Every other action is applied live through
# `niri msg output`, which niri forgets on the next config reload -- so ctrl-z,
# or just quitting, leaves the saved config untouched.
#
# Keys
#   enter   place this output relative to another
#   ctrl-t  rotate           ctrl-x  scale
#   ctrl-a  hand placement back to niri (position auto)
#   ctrl-s  save to host.kdl ctrl-z  revert live changes to the startup layout
#   ctrl-r  rescan           esc     quit

set -g DOTFILES (set -q DOTFILES; and echo $DOTFILES; or echo $HOME/.dotfiles)
set -g HOST (hostname)
set -g HOSTKDL $DOTFILES/hosts/$HOST/dot-config/niri/host.kdl
set -g SELF (realpath (status filename))
set -g TMPDIR_TUI (mktemp -d /tmp/monitor-tui.XXXXXX)
set -g STATE $TMPDIR_TUI/outputs.json
set -g ORIGINAL $TMPDIR_TUI/original.json

function _cleanup --on-event fish_exit
    test -d "$TMPDIR_TUI"; and rm -rf $TMPDIR_TUI
end

function _die
    echo "monitor-tui: $argv" >&2
    exit 1
end

# --- niri state --------------------------------------------------------------

function refresh
    niri msg --json outputs >$STATE 2>/dev/null
    or _die "niri is not running, or its IPC is unavailable"
end

# connector names of every output that is currently on
function active_outputs
    jq -r 'to_entries[] | select(.value.logical != null) | .key' $STATE
end

# the name niri prints for an output: "make model serial", serial-less
# panels rendering as "Unknown" -- this is the EDID form host.kdl prefers,
# because connector names move when a cable changes port.
function edid_name --argument-names out
    jq -r --arg o $out '.[$o] | "\(.make) \(.model) \(.serial // "Unknown")"' $STATE
end

function logical --argument-names out field
    jq -r --arg o $out --arg f $field '.[$o].logical[$f]' $STATE
end

function scale_of --argument-names out
    jq -r --arg o $out '.[$o].logical.scale' $STATE
end

# niri reports transforms capitalised ("Normal", "_90"); host.kdl wants the
# lowercase CLI spelling ("normal", "90").
function transform_of --argument-names out
    jq -r --arg o $out '.[$o].logical.transform
        | ascii_downcase | sub("^_"; "") | sub("^flipped_"; "flipped-")' $STATE
end

# --- placement ---------------------------------------------------------------

# niri reports logical sizes truncated: a 2560x1600 panel at scale 1.5 is
# 1706.67x1066.67 but comes back as 1706x1066. Butt an output against those
# numbers and it overlaps its neighbour by a fraction of a pixel, whereupon
# niri silently discards the position and auto-places the output instead --
# exit status 0, no message. So extents are recomputed from mode/scale and
# rounded up, and a 90/270 transform swaps them.
set -g JQ_EXT 'def ext: .modes[.current_mode] as $m | .logical.scale as $s |
    (if (.logical.transform | ascii_downcase | test("90|270"))
     then [$m.height, $m.width] else [$m.width, $m.height] end)
    | [(.[0] / $s | ceil), (.[1] / $s | ceil)];'

# Apply a whole arrangement, given "<name> <x> <y>" lines.
function apply_targets
    # Furthest corner first. Every position here is final and valid, but an
    # output moved early can still overlap one that has not moved yet, so the
    # order matters; a second pass settles whatever the first had to refuse.
    set -l sorted (printf '%s\n' $argv \
        | awk '{ print $2 + $3, $0 }' | sort -k1,1nr | cut -d' ' -f2-)
    for pass in 1 2
        for l in $sorted
            set -l f (string split ' ' -- $l)
            niri msg output $f[1] position set -- $f[2] $f[3] >/dev/null 2>&1
        end
    end
    refresh
end

# Pin every output to where it already is. An output with no explicit
# position is placed by niri itself, and it slides to a new spot whenever a
# neighbour moves -- so moving one output would shove the others around.
# Pinning first makes a placement affect only the output it names.
function pin_all
    apply_targets (jq -r 'to_entries[] | select(.value.logical != null)
        | "\(.key) \(.value.logical.x) \(.value.logical.y)"' $STATE)
end

# shift the whole arrangement so its top-left corner is 0,0
function normalize
    refresh
    apply_targets (jq -r '[to_entries[] | select(.value.logical != null)
        | {name: .key, x: .value.logical.x, y: .value.logical.y}]
        | ([.[].x] | min) as $mx | ([.[].y] | min) as $my
        | .[] | "\(.name) \(.x - $mx) \(.y - $my)"' $STATE)
end

# rel is above|below|left|right; align is the cross-axis edge to line up on,
# centre when unset. Side placements align top/bottom, stacked ones left/right.
# The full arrangement is computed and normalised here, then applied in one
# go -- niri never sees a half-finished layout with outputs overlapping
function place --argument-names out rel ref align
    test -z "$align"; and set align center
    apply_targets (jq -r --arg a $out --arg b $ref --arg rel $rel --arg al $align \
        "$JQ_EXT"'
        . as $all
        | ($all[$a] | ext) as $A | ($all[$b] | ext) as $B
        | $all[$b].logical as $BL
        | (if $rel == "left" or $rel == "right" then
              (if   $al == "top"    then $BL.y
               elif $al == "bottom" then $BL.y + $B[1] - $A[1]
               else                      $BL.y + (($B[1] - $A[1]) / 2 | round) end)
           else
              (if   $al == "left"  then $BL.x
               elif $al == "right" then $BL.x + $B[0] - $A[0]
               else                     $BL.x + (($B[0] - $A[0]) / 2 | round) end)
           end) as $off
        | (if   $rel == "above" then [$off, $BL.y - $A[1]]
           elif $rel == "below" then [$off, $BL.y + $B[1]]
           elif $rel == "left"  then [$BL.x - $A[0], $off]
           else                       [$BL.x + $B[0], $off] end) as $new
        | [ $all | to_entries[] | select(.value.logical != null)
            | {name: .key,
               x: (if .key == $a then $new[0] else .value.logical.x end),
               y: (if .key == $a then $new[1] else .value.logical.y end)} ]
        | ([.[].x] | min) as $mx | ([.[].y] | min) as $my
        | .[] | "\(.name) \(.x - $mx) \(.y - $my)"' $STATE)
end

function pick_placement --argument-names out
    set -l menu
    for other in (active_outputs)
        test "$other" = "$out"; and continue
        set -a menu "above    $other" "below    $other" \
            "left of  $other" "right of $other"
    end
    test (count $menu) -eq 0; and return
    set -l choice (printf '%s\n' $menu \
        | fzf --prompt "place $out> " --height 40% --reverse)
    test -z "$choice"; and return
    set -l parts (string split -n ' ' $choice)
    set -l rel $parts[1]
    set -l ref $parts[-1]

    # centre first, so enter-enter is the common case
    set -l opts center top bottom
    test "$rel" = above -o "$rel" = below; and set opts center left right
    set -l align (printf '%s\n' $opts \
        | fzf --prompt "align $out ($rel $ref)> " --height 40% --reverse)
    test -z "$align"; and return
    place $out $rel $ref $align
end

function pick_transform --argument-names out
    set -l choice (printf '%s\n' normal 90 180 270 \
            flipped flipped-90 flipped-180 flipped-270 \
        | fzf --prompt "rotate $out> " --height 40% --reverse)
    test -z "$choice"; and return
    niri msg output $out transform $choice >/dev/null
    normalize
end

function pick_scale --argument-names out
    set -l choice (printf '%s\n' auto 1 1.25 1.5 1.75 2 2.5 3 'custom...' \
        | fzf --prompt "scale $out> " --height 40% --reverse)
    test -z "$choice"; and return
    if test "$choice" = custom...
        read -P (set_color cyan)"scale factor> "(set_color normal) choice
        test -z "$choice"; and return
    end
    if not niri msg output $out scale $choice >/dev/null 2>&1
        echo "niri rejected scale '$choice'"
        pause
        return
    end
    normalize
end

# --- the map -----------------------------------------------------------------

# Drawn from a fresh IPC read rather than $STATE: fzf runs the preview in its
# own process, which never sees this shell's temp files.
function render_map
    niri msg --json outputs 2>/dev/null | jq -r '
        to_entries[] | select(.value.logical != null)
        | "\(.key) \(.value.logical.x) \(.value.logical.y) \(.value.logical.width) \(.value.logical.height) \(.value.logical.transform)"' \
    | awk '
    { n[NR]=$1; x[NR]=$2; y[NR]=$3; w[NR]=$4; h[NR]=$5; t[NR]=$6; c=NR
      if (NR==1 || $2 < minx) minx=$2
      if (NR==1 || $3 < miny) miny=$3
      if (NR==1 || $2+$4 > maxx) maxx=$2+$4
      if (NR==1 || $3+$5 > maxy) maxy=$3+$5 }
    END {
      if (c == 0) { print "  (no active outputs)"; exit }
      gw = 62; gh = 16
      sx = gw / (maxx - minx); sy = gh / (maxy - miny)
      s  = (sx < sy) ? sx : sy
      for (r = 0; r <= gh; r++) for (col = 0; col <= gw; col++) g[r,col] = " "
      for (i = 1; i <= c; i++) {
        c0 = int((x[i]-minx)*s); r0 = int((y[i]-miny)*s)
        c1 = int((x[i]+w[i]-minx)*s); r1 = int((y[i]+h[i]-miny)*s)
        if (c1 <= c0+1) c1 = c0+2
        if (r1 <= r0+1) r1 = r0+2
        for (col = c0; col <= c1; col++) { g[r0,col]="-"; g[r1,col]="-" }
        for (r = r0; r <= r1; r++)       { g[r,c0]="|";  g[r,c1]="|" }
        g[r0,c0]="+"; g[r0,c1]="+"; g[r1,c0]="+"; g[r1,c1]="+"
        lab = n[i]; if (t[i] != "Normal") lab = lab " " t[i]
        if (length(lab) > c1-c0-1) lab = substr(lab, 1, c1-c0-1)
        for (k = 1; k <= length(lab); k++) g[r0+1, c0+k] = substr(lab, k, 1)
        dim = w[i] "x" h[i]
        if (length(dim) <= c1-c0-1 && r0+2 < r1)
          for (k = 1; k <= length(dim); k++) g[r0+2, c0+k] = substr(dim, k, 1)
      }
      for (r = 0; r <= gh; r++) {
        line = ""
        for (col = 0; col <= gw; col++) line = line g[r,col]
        sub(/ +$/, "", line)
        print "  " line
      }
    }'
end

# --- host.kdl ----------------------------------------------------------------

# The block name to write for an output: whichever spelling host.kdl already
# uses, so an existing hand-written block is edited rather than duplicated.
# Failing that, the EDID name.
function block_name --argument-names out
    set -l edid (edid_name $out)
    if test -f $HOSTKDL
        for candidate in $out $edid
            if awk -v t="$candidate" '
                /^[[:space:]]*\/\// { next }
                /^[[:space:]]*output[[:space:]]+"/ {
                    s=$0; sub(/^[^"]*"/,"",s); nm=s; sub(/".*$/,"",nm)
                    if (nm == t) { found=1} }
                END { exit !found }' $HOSTKDL
                echo $candidate
                return
            end
        end
    end
    echo $edid
end

# Rewrite one output block in place. Only the three properties this tool
# manages -- position, transform, scale -- are replaced; every other line,
# comments and commented-out blocks included, survives untouched. A block
# that does not exist yet is appended.
function kdl_write --argument-names file target
    # The properties arrive as separate arguments and are re-joined here.
    # Passing them as one newline-joined string does not survive: fish
    # splits a command substitution on newlines, so only the first line
    # would reach awk -- which, with the strip below, silently deleted the
    # rest of the block's properties.
    set -l props $argv[3..-1]
    set -l blob (string join \n $props | string collect)
    set -l tmp $TMPDIR_TUI/host.kdl.new
    awk -v target="$target" -v props="$blob" '
        function emit(   k, i, arr) {
            k = split(props, arr, "\n")
            for (i = 1; i <= k; i++) if (arr[i] != "") print "  " arr[i]
        }
        # Only the properties this call is about to re-emit are stripped, so
        # a short props list can leave a line stale but can never delete one.
        BEGIN {
            k = split(props, arr, "\n")
            for (i = 1; i <= k; i++) {
                key = arr[i]; sub(/[[:space:]].*$/, "", key)
                if (key != "") managed[key] = 1
            }
        }
        /^[[:space:]]*\/\// { print; next }          # comments are structure-free
        !inblk && /^[[:space:]]*output[[:space:]]+"/ {
            s=$0; sub(/^[^"]*"/,"",s); nm=s; sub(/".*$/,"",nm)
            if (nm == target) { inblk=1; found=1; print; next }
        }
        inblk && ($1 in managed) { next }
        inblk && /^[[:space:]]*}/ { emit(); inblk=0; print; next }
        { print }
        END {
            if (!found) {
                print ""
                print "output \"" target "\" {"
                emit()
                print "}"
            }
        }' $file >$tmp
    and mv $tmp $file
end

function save_layout
    test -f $HOSTKDL; or _die "no host.kdl for '$HOST' at $HOSTKDL"
    refresh
    for o in (active_outputs)
        set -l name (block_name $o)
        # All three are always written: an omitted transform would leave a
        # stale rotation behind when an output is turned back to normal.
        set -l props "position x="(logical $o x)" y="(logical $o y) \
            "scale "(scale_of $o) \
            "transform \""(transform_of $o)"\""
        kdl_write $HOSTKDL $name $props
        echo "  $name"
        for p in $props
            echo "    $p"
        end
    end
    echo
    if niri validate -c $HOME/.config/niri/config.kdl 2>&1 | grep -q "config is valid"
        set_color green; echo "written to $HOSTKDL and niri accepts it"; set_color normal
    else
        set_color red; echo "written, but niri rejects the result -- check $HOSTKDL"; set_color normal
    end
    pause
end

# --- live changes ------------------------------------------------------------

function snapshot_original
    cp $STATE $ORIGINAL
end

function revert_live
    for o in (active_outputs)
        set -l x (jq -r --arg o $o '.[$o].logical.x' $ORIGINAL)
        test "$x" = null; and continue
        set -l y (jq -r --arg o $o '.[$o].logical.y' $ORIGINAL)
        set -l sc (jq -r --arg o $o '.[$o].logical.scale' $ORIGINAL)
        set -l t (jq -r --arg o $o '.[$o].logical.transform
            | ascii_downcase | sub("^_"; "") | sub("^flipped_"; "flipped-")' $ORIGINAL)
        niri msg output $o transform $t >/dev/null
        niri msg output $o scale $sc >/dev/null
        niri msg output $o position set -- $x $y >/dev/null
    end
    refresh
end

# --- views -------------------------------------------------------------------

function pause
    read -P (set_color -d)'-- enter to continue --'(set_color normal) >/dev/null
end

function output_lines
    for o in (active_outputs)
        printf '%-10s %5sx%-5s at %5s,%-5s  x%-5s %-11s %s\n' \
            $o (logical $o width) (logical $o height) \
            (logical $o x) (logical $o y) \
            (scale_of $o) (transform_of $o) (edid_name $o)
    end
end

function main_view
    while true
        set -l res (output_lines | fzf \
            --prompt 'output> ' --reverse --height 100% --header-first \
            --header 'enter place · ctrl-t rotate · ctrl-x scale · ctrl-a auto · ctrl-s save · ctrl-z revert · ctrl-r rescan · esc quit' \
            --preview "$SELF __map" --preview-window 'up,19,border-bottom' \
            --expect 'ctrl-t,ctrl-x,ctrl-a,ctrl-s,ctrl-z,ctrl-r,esc')
        test (count $res) -lt 2; and return
        set -l key $res[1]
        set -l out (string split -n ' ' $res[2])[1]
        switch $key
            case esc
                return
            case ctrl-r
                refresh
                pin_all
            case ctrl-s
                save_layout
            case ctrl-z
                revert_live
            case ctrl-a
                # deliberately no normalize/pin: that would hand the output
                # an explicit position again and undo the auto
                niri msg output $out position auto >/dev/null
                refresh
            case ctrl-t
                pick_transform $out
            case ctrl-x
                pick_scale $out
            case '*'
                pick_placement $out
        end
    end
end

# --- entry -------------------------------------------------------------------

if test "$argv[1]" = __map
    render_map
    exit 0
end

type -q niri; or _die "niri not found"
type -q jq; or _die "jq not found"
type -q fzf; or _die "fzf not found"

refresh
snapshot_original
pin_all
main_view
