// rodii-power-menu — the niri power / system menu (Mod+Escape), which-key style.
// Binary: ~/Projects/rodii-power-menu. Read on every open: edit, press
// Mod+Escape, no rebuild.
//
//   rodii-power-menu validate   check this file (line numbers, like niri validate)
//   rodii-power-menu print      every page as fuzzel gets it, with live states
//
// Pages open in file order: Mod+Escape shows the first; Mod+Escape again while
// it's open flips to the next (wraps). Esc goes back a level / closes.
// Search is flat: typing on any page finds every item on every page and group.
//
// Nodes (inside a page, group or define):
//   item "Label" icon=… run=… keywords=…   a command; run is `sh -c`, with
//                                         ~/.local/bin on PATH
//   group "Label" icon=… hint=… { … }      a ▸ row opening a submenu (nests)
//   link "Label" page="Name" hint=…        a ▸ row jumping to another page
//   use "id"                               the item/group that has id="id"
//                                          (defined anywhere, in any order)
// Any of them can take id="…" so it can be `use`d elsewhere. `define { … }`
// holds items only reachable through `use`.
//
// Live items: an item with a `state` command (child node) and `when` variants.
// The command's first output line picks the matching `when` ("*" = fallback);
// a variant overrides icon / label / run / keywords / hint. `detail "cmd"`
// shows its output as a right-hand column. All state/detail commands run in
// parallel; any slower than state-timeout-ms show their last known value.
// A detail shows its cached value at once and refreshes in the background;
// add fresh=#true to wait for it like a state (for fast, often-changing ones).
//
// Icons: write nerd-font glyphs as escapes ("\u{f023}"): the private-use ones
// are invisible and get lost in edits. Commands containing " go in raw strings:
// #"…"#. Put /- before any node to switch it off.

state-timeout-ms 40
fuzzel "--font=JetBrainsMono Nerd Font Mono:size=14"

page "Power" {
    item "Lock" icon="\u{f033e}" run="loginctl lock-session"
    item "Suspend" icon="\u{f0904}" run="systemctl suspend" keywords="sleep"
    item "Reboot [Restart]" icon="\u{f0709}" run="systemctl reboot"
    item "Shutdown" icon="\u{f0425}" run="systemctl poweroff" keywords="power off"
    item "Exit session" icon="\u{f0a48}" run="niri msg action quit" keywords="logout log out quit niri"

    // FIDO2 key in the shared ssh-agent: 0 = loaded, 1 = no identities, else
    // no agent. Unlocking needs a TTY (passphrase + YubiKey touch).
    item "SSH key" keywords="yubikey fido" {
        state "ssh-add -l >/dev/null 2>&1; echo $?"
        when "0" icon="\u{f0306}" label="SSH key: loaded → lock (drop from agent)" run="ssh-unlock lock"
        when "1" icon="\u{f0341}" label="SSH key: locked → unlock" run=#"ghostty --title="SSH Unlock" --class=ssh-unlock -e ssh-unlock"#
        when "*" icon="\u{f1983}" label="SSH key: agent DOWN → diagnose" run=#"ghostty --title="SSH Unlock" --class=ssh-unlock -e ssh-unlock"#
    }

    group "Network" icon="\u{f0928}" hint="Wi-Fi · Bluetooth" {
        item "Wi-Fi" icon="\u{f0928}" run="ghostty --title=Impala --class=Impala -e impala" keywords="wifi wireless impala" {
            // The connected network, straight from the kernel (~1 ms, any
            // interface name, works under iwd or NetworkManager). fresh: it
            // changes when you move, so the menu waits for it.
            detail "iw dev | sed -n 's/^[[:space:]]*ssid //p' | head -n1 | grep . || echo 'not connected'" fresh=#true
        }
        item "Bluetooth" icon="\u{f00af}" run="ghostty --title=BlueTUI --class=bluetui -e bluetui" keywords="bt bluetui headphones"
    }

    group "Audio" icon="\u{f057e}" hint="mute · mixers" {
        // Live state: the action that WOULD happen, plus the default device.
        // pactl answers ~2x faster than wpctl; the device name (detail) is
        // only descriptive, so it refreshes in the background.
        item "Mute speakers" icon="\u{f057e}" run="swayosd-client --output-volume mute-toggle" keywords="mute unmute" {
            state "pactl get-sink-mute @DEFAULT_SINK@"
            when "Mute: yes" icon="\u{f0581}" label="Unmute speakers"
            detail #"wpctl inspect @DEFAULT_AUDIO_SINK@ | awk -F'"' '/node.nick/ {n=$2} /node.description/ {d=$2} END {print n ? n : d}'"#
        }
        item "Mute mic" icon="\u{f036c}" run="swayosd-client --input-volume mute-toggle" keywords="mute unmute" {
            state "pactl get-source-mute @DEFAULT_SOURCE@"
            when "Mute: yes" icon="\u{f036d}" label="Unmute mic"
            detail #"wpctl inspect @DEFAULT_AUDIO_SOURCE@ | awk -F'"' '/node.nick/ {n=$2} /node.description/ {d=$2} END {print n ? n : d}'"#
        }
        item "Sound" icon="\u{f066a}" run="ghostty --title=Wiremix --class=Wiremix -e wiremix -v output" keywords="volume mixer output"
        item "Microphone" icon="\u{f036f}" run="ghostty --title=Wiremix --class=Wiremix -e wiremix -v input" keywords="mixer input mic"
    }

    group "Displays" icon="\u{f0379}" hint="DDC · monitor layout" {
        item "External Display (DDC)" icon="\u{f00df}" run=#"ghostty --title="External Display" --class=ext-display -e ext-display"# keywords="brightness"
        item "Monitor layout" icon="\u{f037a}" run=#"ghostty --title="Monitor Layout" --class=dev.rdlu.MonitorTui -e monitor-tui"#
    }

    item "System Monitor" icon="\u{f0127}" run="ghostty --class=btop --title=btop -e btop" keywords="top processes"
    link "More tools" icon="\u{f035c}" page="Tools" hint="Mod+Esc again"
}

page "Tools" {
    // Clocks: live times on the rows, and copy-to-clipboard in each zone.
    // Every value is taken when you press Enter (wl-copy + a notification
    // showing what was copied). To add a zone, copy a zone group and change
    // its TZ=… (names from `timedatectl list-timezones`).
    group "Clocks" icon="\u{f0150}" keywords="time date clock timezone" detail=#"echo "$(date +%H:%M) · Munich $(TZ=Europe/Berlin date +%H:%M)""# fresh=#true {
        group "São Paulo" icon="\u{f01e7}" keywords="local sao paulo brazil" detail="date '+%a %d %b  %H:%M  %Z'" fresh=#true {
            item "Copy date · São Paulo" icon="\u{f00ed}" keywords="iso date today local sao paulo" run=##"v=$(date +%F); printf %s "$v" | wl-copy && notify-send -a Clocks -t 2500 "Copied" "$v""## detail="date +%F" fresh=#true
            item "Copy datetime · São Paulo" icon="\u{f0150}" keywords="iso datetime now local sao paulo" run=##"v=$(date -Iseconds); printf %s "$v" | wl-copy && notify-send -a Clocks -t 2500 "Copied" "$v""## detail="date -Iseconds" fresh=#true
        }
        group "Munich" icon="\u{f01e7}" keywords="munich munchen germany berlin cet cest europe" detail="TZ=Europe/Berlin date '+%a %d %b  %H:%M  %Z'" fresh=#true {
            item "Copy date · Munich" icon="\u{f00ed}" keywords="iso date today munich germany" run=##"v=$(TZ=Europe/Berlin date +%F); printf %s "$v" | wl-copy && notify-send -a Clocks -t 2500 "Copied" "$v""## detail="TZ=Europe/Berlin date +%F" fresh=#true
            item "Copy datetime · Munich" icon="\u{f0150}" keywords="iso datetime now munich germany" run=##"v=$(TZ=Europe/Berlin date -Iseconds); printf %s "$v" | wl-copy && notify-send -a Clocks -t 2500 "Copied" "$v""## detail="TZ=Europe/Berlin date -Iseconds" fresh=#true
        }
        group "Shenzhen" icon="\u{f01e7}" keywords="shenzhen shenzen china beijing shanghai asia" detail="TZ=Asia/Shanghai date '+%a %d %b  %H:%M  %Z'" fresh=#true {
            item "Copy date · Shenzhen" icon="\u{f00ed}" keywords="iso date today shenzhen shenzen china beijing shanghai asia" run=##"v=$(TZ=Asia/Shanghai date +%F); printf %s "$v" | wl-copy && notify-send -a Clocks -t 2500 "Copied" "$v""## detail="TZ=Asia/Shanghai date +%F" fresh=#true
            item "Copy datetime · Shenzhen" icon="\u{f0150}" keywords="iso datetime now shenzhen shenzen china beijing shanghai asia" run=##"v=$(TZ=Asia/Shanghai date -Iseconds); printf %s "$v" | wl-copy && notify-send -a Clocks -t 2500 "Copied" "$v""## detail="TZ=Asia/Shanghai date -Iseconds" fresh=#true
        }
        group "Vancouver" icon="\u{f01e7}" keywords="vancouver canada british columbia bc pacific pst pdt" detail="TZ=America/Vancouver date '+%a %d %b  %H:%M  %Z'" fresh=#true {
            item "Copy date · Vancouver" icon="\u{f00ed}" keywords="iso date today vancouver canada british columbia bc pacific pst pdt" run=##"v=$(TZ=America/Vancouver date +%F); printf %s "$v" | wl-copy && notify-send -a Clocks -t 2500 "Copied" "$v""## detail="TZ=America/Vancouver date +%F" fresh=#true
            item "Copy datetime · Vancouver" icon="\u{f0150}" keywords="iso datetime now vancouver canada british columbia bc pacific pst pdt" run=##"v=$(TZ=America/Vancouver date -Iseconds); printf %s "$v" | wl-copy && notify-send -a Clocks -t 2500 "Copied" "$v""## detail="TZ=America/Vancouver date -Iseconds" fresh=#true
        }
        group "UTC" icon="\u{f01e7}" keywords="utc gmt zulu" detail="date -u '+%a %d %b  %H:%M  UTC'" fresh=#true {
            item "Copy date · UTC" icon="\u{f00ed}" keywords="iso date today utc" run=##"v=$(date -u +%F); printf %s "$v" | wl-copy && notify-send -a Clocks -t 2500 "Copied" "$v""## detail="date -u +%F" fresh=#true
            item "Copy datetime · UTC" icon="\u{f0150}" keywords="iso datetime now utc zulu" run=##"v=$(date -u +%Y-%m-%dT%H:%M:%SZ); printf %s "$v" | wl-copy && notify-send -a Clocks -t 2500 "Copied" "$v""## detail="date -u +%Y-%m-%dT%H:%M:%SZ" fresh=#true
        }

        // A Unix timestamp is the same in every zone, so it's here once.
        item "Copy Unix timestamp" icon="\u{f03a0}" keywords="timestamp epoch unix seconds" run=##"v=$(date +%s); printf %s "$v" | wl-copy && notify-send -a Clocks -t 2500 "Copied" "$v""## detail="date +%s" fresh=#true
        item "Copy timestamp (ms)" icon="\u{f03a0}" keywords="timestamp epoch unix millis milliseconds" run=##"v=$(date +%s%3N); printf %s "$v" | wl-copy && notify-send -a Clocks -t 2500 "Copied" "$v""## detail="date +%s%3N" fresh=#true
    }

    group "Sharing" icon="\u{f0497}" hint="SMB · LocalSend · SSH/rsync in" {
        item "SMB Shares" icon="\u{f0870}" run=#"ghostty --title="SMB Manager" --class=smb-tui -e smb-tui"# keywords="samba"
        item "LocalSend share (temp)" icon="\u{f048a}" run="localsend-here on"
        item "LocalSend close" icon="\u{f07ed}" run="localsend-here off"
        item "SSH/rsync in (temp)" icon="\u{f0318}" run="ssh-here on"
        item "SSH/rsync close" icon="\u{f0319}" run="ssh-here off"
    }

    // Caffeine is ON when swayidle is NOT active (caffeine stopped it).
    item "Caffeine" icon="\u{f0176}" keywords="awake idle" {
        state "systemctl --user is-active -q swayidle.service && echo off || echo on"
        when "on" label="Caffeine: ON (keeping awake) → turn OFF" run="caffeine off"
        when "off" icon="\u{f0faa}" label="Caffeine: OFF → keep awake (turn ON)" run="caffeine on"
    }
}
