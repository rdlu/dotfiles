// Block out Noctalia notifications from screencasts.
layer-rule {
    match namespace="^noctalia-notification$"
    opacity 0.8
    block-out-from "screencast"
}

// Make fuzzel semitransparent.
layer-rule {
    match namespace="^launcher$"

    opacity 0.95
}

// Keep the bar out of screencasts, as the old waybar rule did. Its look
// (opacity, corners) is Noctalia's own setting now.
layer-rule {
    match namespace="^noctalia-bar-"
    block-out-from "screencast"
}

// Wallpaper behind the overview, as wpaperd's was.
layer-rule {
    match namespace="^noctalia-wallpaper$"
    place-within-backdrop true
}
