// Game windows: launchers and games open on the "games" workspace (pinned to an
// output in config.kdl). Included right after window-rules.kdl; later rules win
// in niri, and none of these set properties the general rules there also set.

window-rule {
    match app-id=r#"RetroArch$"#
    open-fullscreen true
    open-focused true
    open-on-workspace "games"
    variable-refresh-rate true
    tiled-state false
}

window-rule {
  match app-id="Hollow Knight Silksong"
  open-on-workspace "games"
  open-fullscreen true
  tiled-state false
  open-focused true
  variable-refresh-rate true
}

// Native ports and recomps launched from Heroic. These save their own fullscreen
// state and re-apply it at launch, so forcing open-fullscreen here makes the two
// fight (seen with SpaghettiKart). Let the games own it.
window-rule {
  match app-id="^Spaghettify$"                // SpaghettiKart
  match app-id=r#"^soh\.elf$"#                 // Ship of Harkinian (OoT)
  match app-id="^Starship$"                   // Star Fox 64
  match app-id="^BanjoRecompiled$"
  match app-id="^MarioKart64Recompiled$"
  match app-id="^Zelda64Recompiled$"          // Majora's Mask
  match app-id="^WaveRace64Recomp$"
  match app-id=r#"^dev\.twilitrealm\.dusk$"#   // Dusklight (Twilight Princess)
  match app-id="^Mega Man X Regenesis$"
  match app-id="^zelda3$"                     // A Link to the Past (snesrev)
  match app-id="^sm64coopdx$"                 // Super Mario 64
  match app-id=r#"^pd\.x86_64$"#              // Perfect Dark
  match title="^SymphonyRecomp"               // sets no app-id
  open-on-workspace "games"
  tiled-state false
  open-focused true
  variable-refresh-rate true
}

// F-Zero has no fullscreen option of its own, so niri does it.
window-rule {
  match app-id="^FZeroSNESRecomp$"
  open-on-workspace "games"
  open-fullscreen true
  tiled-state false
  open-focused true
  variable-refresh-rate true
}

window-rule {
    match app-id="es-de"
    open-fullscreen true
    open-focused true
    open-on-workspace "games"
    tiled-state false
}

window-rule {
    match app-id="gamescope"
    match app-id="PrismLauncher$"
    match app-id="steam"
    match app-id="heroic"
    open-on-workspace "games"
}

window-rule {
  match app-id="^steam_app"
  match app-id="gamescope"
  open-on-workspace "games"
  open-fullscreen true
  tiled-state false
  open-focused true
  variable-refresh-rate true
}

// Dont auto focus
window-rule {
    match app-id="steam"
    open-focused false
}
