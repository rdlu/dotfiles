spawn-at-startup "swayosd-server"
// spawn-at-startup "pkexec swayosd-libinput-backend"
spawn-at-startup "xwayland-satellite"
spawn-at-startup "udiskie"
spawn-at-startup "walker --gapplication-service"

environment {
    // DISPLAY ":0"
    GDK_BACKEND "wayland,x11,*"
    QT_QPA_PLATFORM "wayland;xcb"
    // QT_STYLE_OVERRIDE "kvantum"
    // SDL_VIDEODRIVER "wayland"
    // LD_PRELOAD "/usr/lib/libSDL2-2.0.so.0"
    MOZ_ENABLE_WAYLAND "1"
    ELECTRON_OZONE_PLATFORM_HINT "wayland"
    OZONE_PLATFORM "wayland"
    // PROTON_ENABLE_WAYLAND "1"
    CHROMIUM_FLAGS "--enable-features=UseOzonePlatform --ozone-platform=wayland --gtk-version=4"
    XDG_DATA_DIRS "~/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/share:/usr/local/share:~/.local/share"
    TERMINAL "kitty"
    BEMOJI_PICKER_CMD "fuzzel -d \"emojis\""
    EDITOR "nvim"
    // Follow the mimeapps default (zen) instead of naming a browser here.
    // Absolute: niri neither expands ~ nor has ~/.local/bin on its PATH.
    BROWSER "/home/rdlu/.local/bin/xdg-browser"
    // desktop-theme owns GTK theming; GTK_THEME overrides it and breaks
    // libadwaita. null unsets it for spawned apps even if something leaked it.
    GTK_THEME null
}
