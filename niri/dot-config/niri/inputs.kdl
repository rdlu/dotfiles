// https://github.com/YaLTeR/niri/wiki/Configuration:-Input
input {
    keyboard {
        xkb {
            // options "grp:win_space_toggle,compose:ralt,ctrl:nocaps"
            // usbr = us(altgr-intl) + AltGr+w/p for ã/õ: ~/.config/xkb/symbols/usbr
            // Single layout on purpose: fcitx5 owns switching (Mod+Space) and
            // each host's br variant lives in its fcitx5 profile. This is only
            // the keymap when fcitx5 isn't running.
            layout "usbr";
            // layout "us,br"; variant "altgr-intl";
            // options "grp:win_space_toggle"
        }
        track-layout "global"
        numlock
    }

    // Next sections include libinput settings.
    // Omitting settings disables them, or leaves them at their default values.
    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        natural-scroll
        accel-speed 0.6
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // middle-emulation
    }

    warp-mouse-to-focus

    // Focus windows and outputs automatically when moving the mouse into them.
    // Setting max-scroll-amount="0%" makes it work only on windows already fully on screen.
    focus-follows-mouse max-scroll-amount="30%"
}

cursor {
  xcursor-theme "Adwaita"
  xcursor-size 32

  hide-when-typing
  hide-after-inactive-ms 1000
}
