# empty Enter must submit: swaylock only starts the PAM conversation on
# submit, and an empty password is what falls through pam_unix to reach
# pam_fprintd, which then arms the reader. Never add ignore-empty-password --
# it swallows the empty submit, PAM never runs, and the reader looks dead
# while the password still works.
#
# Ordering in /etc/pam.d/swaylock is pam_unix FIRST, then pam_fprintd. That is
# what keeps a typed password instant. Do not reorder, and do not substitute
# pam_fprintd_grosshack.so here -- it belongs in sudo/polkit-1 only; see the
# comments in /etc/pam.d/swaylock.
show-failed-attempts
daemonize
color=232136
font=Inter
font-size=18
indicator-thickness=8

screenshots
effect-blur=7x5
effect-vignette=0.5:0.5
indicator
indicator-radius=120
clock
# 24h, minute resolution on purpose: a per-second clock makes swaylock redraw
# every second, which (like hyprlock) keeps the panel lit and defeats the idle
# monitor power-off. Minute resolution stays static enough to blank while locked.
timestr=%H:%M
datestr=%A, %d %B %Y
ring-color=4C566A
key-hl-color=A3BE8C
line-color=2E3440
separator-color=3B4252
inside-color=3B4252
bs-hl-color=A3BE8C
layout-bg-color=3B4252
layout-border-color=4C566A
layout-text-color=D8DEE9
text-color=D8DEE9
