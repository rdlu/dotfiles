#!/usr/bin/fish

# caffeine — temporarily keep the screen awake (no idle lock, no blanking).
#
# Thin wrapper over Noctalia's caffeine, an idle inhibitor that its idle
# behaviors ([idle] in noctalia/config.toml) respect. Noctalia's OSD shows the
# new state; it has no state query, so there is no `status`. Runtime only:
# restarting Noctalia or logging out turns it off. Suspend still locks first
# (Noctalia's lock_before_suspend), caffeine or not.
#
# Usage: caffeine [on | off | toggle]   (default: toggle)

set -l cmd $argv[1]
test -n "$cmd"; or set cmd toggle

switch $cmd
    case on
        noctalia msg caffeine-enable
    case off
        noctalia msg caffeine-disable
    case toggle
        noctalia msg caffeine-toggle
    case '*'
        echo "usage: caffeine [on|off|toggle]" >&2
        exit 2
end
