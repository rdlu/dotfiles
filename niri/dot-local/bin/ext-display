#!/usr/bin/fish

# ext-display -- a small gum TUI to drive the external monitor over DDC/CI
# (ddcutil), for when the physical buttons are hard to reach. Adjust
# brightness / contrast / sharpness, switch the input source, pick a colour
# preset, or restore the brightness/contrast defaults.
#
# Driven by single-key shortcuts: b/c/s pick a level (digits 1-9 = 10-90%,
# 0 = 100%), i switches input, p picks a preset, r restores defaults,
# q (or Esc) quits.
#
# Exposed as `mise run ext-display` / `just ext-display`; also on PATH. For a
# one-shot brightness step (and the swayosd OSD) use `ext-brightness` instead;
# this is the interactive panel.
#
# CAVEAT on input switching: this HG540T40 ignores DDC input-source *writes*
# once it lands on a signal-less input, so switching to an input with nothing
# powered on strands it there until you replug the cable. Switching between
# inputs that DO have a live device (another PC, a console) is fine, and the
# monitor drops back to this machine when that device powers off -- hence the
# explicit warning + confirm before a switch.

set -g DISP 1   # ddcutil display number -- see ext-brightness for why 1 is the
                # external monitor (laptop panels have no DDC/CI).

for tool in ddcutil gum
    if not type -q $tool
        echo "ext-display: '$tool' is not installed" >&2
        exit 1
    end
end

# --- helpers ---------------------------------------------------------------

# Current / max value of a VCP feature from `--brief` (VCP <code> C <cur> <max>).
function _cur --argument-names code
    set -l p (ddcutil getvcp $code --display $DISP --brief 2>/dev/null | string split ' ')
    echo $p[4]
end
function _max --argument-names code
    set -l p (ddcutil getvcp $code --display $DISP --brief 2>/dev/null | string split ' ')
    test -n "$p[5]"; and echo $p[5]; or echo 100
end
function _input_name
    ddcutil getvcp 60 --display $DISP 2>/dev/null \
        | grep -oE '[A-Za-z]+Port-[0-9]|HDMI-[0-9]|DVI-[0-9]|VGA-[0-9]' | head -1
end

function _toast --argument-names msg
    gum style --foreground 42 "  $msg"
end

# Pick a level for a 0..max feature with a single keystroke: digits 1-9 map
# to 10-90% of max, 0 means 100%; q/Esc/Enter goes back without changing
# anything. (For sharpness, max is small, so e.g. 5 -> 5/10.)
function _pick_level --argument-names code label
    set -l max (_max $code)
    set -l cur (_cur $code)
    echo
    gum style --foreground 63 "$label -- now $cur/$max.   1-9 = 10-90%   0 = 100%   q = back"
    read -l --nchars 1 -P "  > " key; or return
    string match -qr '^[0-9]$' -- $key; or return
    set -l pick (math "round($key * $max / 10)")
    test "$key" = 0; and set pick $max
    ddcutil setvcp --noverify $code $pick --display $DISP 2>/dev/null
    # Mirror the OSD for brightness, matching the keybind behaviour.
    if test "$code" = 10; and type -q swayosd-client
        swayosd-client --custom-progress (math "$pick / $max") \
            --custom-progress-text "$pick%" --custom-icon display-brightness-symbolic
    end
    _toast "$label -> $pick"
end

function _pick_input
    # sl values from `ddcutil capabilities`.
    set -l names DisplayPort-1 DisplayPort-2 HDMI-1 HDMI-2 DVI-1 DVI-2 VGA-1
    set -l codes    0f            10         11     12     03    04    01
    set -l pick (gum choose --header "Switch input (now: "(_input_name)"):" $names)
    test -z "$pick"; and return
    set -l i (contains -i -- $pick $names)
    gum style --foreground 214 \
        "Only switch to an input that has a powered-on device." \
        "This monitor ignores DDC input changes once it sits on a dead input," \
        "so a wrong switch means replugging the cable to get back."
    if gum confirm "Switch monitor to $pick?"
        ddcutil setvcp 60 0x$codes[$i] --display $DISP 2>/dev/null
        _toast "input -> $pick"
    end
end

function _pick_preset
    set -l names sRGB "Display Native" "5000 K" "6500 K" "7500 K" "9300 K" "User 1"
    set -l codes 01    02               04       05       06       08       0b
    set -l pick (gum choose --header "Colour preset:" $names)
    test -z "$pick"; and return
    set -l i (contains -i -- $pick $names)
    ddcutil setvcp 14 0x$codes[$i] --display $DISP 2>/dev/null
    _toast "preset -> $pick"
end

# --- main loop -------------------------------------------------------------

while true
    command clear
    set -l b (_cur 10)
    set -l c (_cur 12)
    gum style --border rounded --padding "0 1" --border-foreground 63 \
        "External monitor  ·  DDC/CI" \
        "Brightness $b/100    Contrast $c/100    Input "(_input_name)

    echo
    echo "  [b] Brightness       [c] Contrast        [s] Sharpness"
    echo "  [i] Input source     [p] Colour preset   [r] Restore defaults"
    echo "  [q] Quit"
    echo
    read -l --nchars 1 -P "  key: " key; or break

    switch "$key"
        case b
            _pick_level 10 Brightness
        case c
            _pick_level 12 Contrast
        case s
            _pick_level 87 Sharpness
        case i
            _pick_input
        case p
            _pick_preset
        case r
            # VCP 05 = restore factory brightness/contrast only (never touches
            # the input source, unlike the broad factory reset 04).
            if gum confirm "Restore factory brightness & contrast?"
                ddcutil setvcp 05 01 --display $DISP 2>/dev/null
                _toast "restored brightness/contrast defaults"
            end
        case q \e
            break
    end
end
