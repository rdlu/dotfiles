#!/usr/bin/fish

# es-de-side — preview ES-DE's highlighted game on the big screen.
#
# Handheld-style dual screen: es-de-launch puts ES-DE's menu on a temporary
# "games-side" workspace on the second screen; this script keeps an mpv window
# on the "games" workspace's screen, where games open too (in front of it).
# It loops the highlighted game's video (or its art when there's no video),
# and on the system view the system's logo on the theme's wallpaper (rendered
# once per theme/scheme/size into ~/.cache/es-de-side). Driven by ES-DE custom
# event scripts, stowed alongside in ~/ES-DE/scripts/<event>/es-de-side; they
# need "Enable custom event scripts" and "Browsing custom events" on in Other
# settings.
#
# Nothing here is permanent: `stop` closes mpv and unnames games-side, so niri
# drops the empty workspace again. With one screen there is no games-side,
# `start` does nothing and every other command is a no-op.
#
# Usage: es-de-side start                       (startup event)
#        es-de-side select ROM NAME SYSTEM FULL (game-select event)
#        es-de-side system SYSTEM FULL ROMPATH   (system-select event)
#        es-de-side pause | resume              (game-start / game-end;
#                                                resume refocuses ES-DE)
#        es-de-side stop                        (quit event)

set -g sock $XDG_RUNTIME_DIR/es-de-side.sock
set -g view_file $XDG_RUNTIME_DIR/es-de-side.output # preview's output, written by start
set -g current $XDG_RUNTIME_DIR/es-de-side.current  # what is highlighted right now
set -g shown $XDG_RUNTIME_DIR/es-de-side.shown      # file mpv has loaded
set -g workspace games-side
set -g app_id es-de-side
set -g settings ~/ES-DE/settings/es_settings.xml
set -g cache ~/.cache/es-de-side

function ipc --description 'send one mpv IPC command; fails if mpv is not up'
    test -S $sock; or return 1
    jq -cn '{command: $ARGS.positional}' --args $argv \
        | socat - UNIX-CONNECT:$sock >/dev/null 2>&1
end

function setting --argument-names name
    string match -r -g "name=\"$name\" value=\"([^\"]*)\"" <$settings
end

function window_id --argument-names app
    niri msg --json windows | jq -r --arg a $app 'first(.[] | select(.app_id == $a) | .id) // empty'
end

function wait_window --argument-names app seconds
    for i in (seq (math $seconds x 4))
        set -l id (window_id $app)
        test -n "$id"; and echo $id; and return 0
        sleep 0.25
    end
    return 1
end

function es_de_running
    pgrep -f '\.mount_[^/]+/usr/bin/es-de( |$)' >/dev/null
end

# Browsing events run in parallel threads and can finish out of order while
# fast-scrolling; each one claims `current` first and only shows its file if
# nothing newer has claimed it since.
function claim --argument-names key
    echo $key >$current
end

# ES-DE re-sends game-select for the same game right after game-start;
# reloading would restart the paused video on its (usually black) first frame.
function show --argument-names key file
    test "$(cat $current 2>/dev/null)" = "$key"; or return 0
    test "$(cat $shown 2>/dev/null)" = "$file"; and return 0
    ipc loadfile $file replace; and echo $file >$shown
end

function theme_dir
    set -l theme (setting Theme)
    for d in ~/ES-DE/themes/$theme /tmp/.mount_esde*/usr/bin/themes/$theme
        test -d $d; and echo $d; and return 0
    end
    return 1
end

# Wallpaper + system logo, styled like the active theme's color scheme
# (backgroundArtPath and systemColor from its colors.xml — Canvas layout,
# degrading to black and a white logo or the system's name elsewhere).
function system_card --argument-names system fullname
    set -l size (niri msg --json outputs | jq -r --arg o "$(cat $view_file 2>/dev/null)" '
        .[$o] | .modes[.current_mode] // empty | "\(.width)x\(.height)"')
    test -n "$size"; or return 1
    set -l theme_name (setting Theme)
    set -l scheme (setting ThemeColorScheme)
    set -l out $cache/$theme_name/$scheme/$size/$system.png
    test -s $out; and echo $out; and return 0

    set -l dir (theme_dir)
    set -l wallpaper
    set -l color ffffff
    if test -n "$dir"; and test -f $dir/colors.xml
        set -l vars (python3 -c '
import sys, xml.etree.ElementTree as ET
f, scheme = sys.argv[1:]
vals = {}
for cs in ET.parse(f).getroot().iter("colorScheme"):
    if scheme in [n.strip() for n in cs.get("name", "").split(",")]:
        for e in cs.findall("variables/*"):
            vals[e.tag] = (e.text or "").strip()
print(vals.get("backgroundArtPath", ""))
print(vals.get("systemColor", ""))' $dir/colors.xml $scheme 2>/dev/null)
        if test -n "$vars[1]"
            set wallpaper $dir/(string replace -r '^\./' '' -- $vars[1]).*
        end
        test -n "$vars[2]"; and set color $vars[2]
    end
    # Auto collections are themed under their folder names (auto-favorites...).
    set -l names $system auto-$system
    switch $system
        case all
            set -a names auto-allgames
        case recent lastplayed
            set -a names auto-lastplayed
    end
    set -l logo
    if test -n "$dir"
        for n in $names
            set logo $dir/_inc/system-logo/$n.svg
            test -f $logo; and break
            set logo (find $dir -ipath '*logo*' -iname "$n.*" -type f | head -1)
            test -n "$logo"; and break
        end
    end

    set -l w (string split x $size)[1]
    set -l h (string split x $size)[2]
    set -l box (math -s0 $w x 0.55)x(math -s0 $h x 0.35)
    set -l bg -size $size xc:'#111111'
    set -q wallpaper[1]; and set bg $wallpaper[1] -resize "$size^" -gravity center -extent $size
    set -l fg -density 600 $logo[1] -resize $box
    test -n "$logo[1]"; or set fg -pointsize 160 label:$fullname -resize $box

    mkdir -p (path dirname $out)
    magick $bg \( -background none $fg -fill "#$color" -colorize 100 \) \
        -gravity center -composite $out.tmp.png 2>/dev/null; or return 1
    mv $out.tmp.png $out
    echo $out
end

# With "Run in background" on, ES-DE only fires game-end once it gets focus
# back — but the game closing hands focus to the preview, so it never would.
# Follow the game's window instead: it's the first new window after
# game-start. Move it onto "games" if no rule put it there (an emulator with
# no niri rule opens next to ES-DE), and when it closes, focus ES-DE, which
# wakes it into game-end.
function watch_game
    set -l skip '^es-de(-side)?$'
    set -l before (niri msg --json windows | jq -r '.[].id')
    set -l game
    for i in (seq 240) # emulators can take a while: up to 2 minutes
        set game (niri msg --json windows | jq -r --arg skip $skip --args '
            first(.[] | select((.app_id // "" | test($skip)) | not)
                      | select((.id | tostring) as $id | $ARGS.positional | index($id) | not)
                      | .id) // empty' $before)
        test -n "$game"; and break
        sleep 0.5
    end
    test -n "$game"; or return 0

    set -l on (niri msg --json windows | jq -r --argjson g $game '.[] | select(.id == $g) | .workspace_id')
    set -l games_ws (niri msg --json workspaces | jq -r 'first(.[] | select(.name == "games") | .id) // empty')
    if test -n "$games_ws"; and test "$on" != "$games_ws"
        niri msg action move-window-to-workspace --window-id $game --focus true games
    end

    while niri msg --json windows | jq -e --argjson g $game 'any(.[]; .id == $g)' >/dev/null
        sleep 0.5
    end
    set -l esde (window_id es-de)
    test -n "$esde"; and niri msg action focus-window --id $esde
end

function system_select --argument-names system fullname
    test -n "$system"; or return 0
    test -S $sock; or return 0
    claim system:$system
    set -l card (system_card $system $fullname); or return 0
    show system:$system $card
end

function start
    set -q NIRI_SOCKET; or return 0
    ipc get_property pause; and return 0 # already running

    # es-de-launch names games-side only when there is a second screen; ES-DE
    # sits there and the preview takes the games workspace's screen.
    niri msg --json workspaces | jq -e '.[] | select(.name == "games-side")' >/dev/null; or return 0
    niri msg --json workspaces | jq -r 'first(.[] | select(.name == "games") | .output) // empty' >$view_file

    # The es-de-side window rule puts it on "games" without taking focus.
    setsid -f mpv --idle=yes --force-window=yes --fullscreen \
        --wayland-app-id=$app_id --title='ES-DE preview' \
        --input-ipc-server=$sock --no-terminal \
        --loop-file=inf --image-display-duration=inf --keep-open=yes \
        --mute=yes --osc=no --osd-level=0 --cursor-autohide=always \
        --background-color='#000000' --hwdec=auto-safe \
        >/dev/null 2>&1 </dev/null

    # Whatever order the two windows map in, ES-DE ends up with the controls
    # (startup fires before ES-DE's own window exists, hence the waits).
    set -l esde (wait_window es-de 20)
    wait_window $app_id 10 >/dev/null
    test -n "$esde"; and niri msg action focus-window --id $esde

    # Cover a crash or kill, where ES-DE never fires quit.
    while es_de_running
        sleep 3
    end
    stop
end

function select --argument-names rom
    # Blank parameters mean fast-scrolling: keep what's on screen.
    test -n "$rom"; or return 0
    test -S $sock; or return 0
    claim game:$rom

    set -l romdir (string trim -r -c / -- (setting ROMDirectory))
    set -l media (string trim -r -c / -- (setting MediaDirectory))
    set -l rel (string replace -- "$romdir/" '' $rom)
    test "$rel" != "$rom"; or return 0 # outside the ROM directory

    # roms/<system>/<sub>/<Name>.zip -> media/<system>/<type>/<sub>/<Name>.*
    set -l system (string split -m1 / -- $rel)[1]
    set -l base (string replace -r '\.[^./]*$' '' -- (string split -m1 / -- $rel)[2])

    for type in videos miximages screenshots covers
        set -l found $media/$system/$type/$base.*
        if set -q found[1]
            show game:$rom $found[1]
            return
        end
    end
    ipc stop; and rm -f $shown # no media: blank rather than show the previous game
end

function stop
    ipc quit
    for i in (seq 20)
        test -S $sock; or break
        sleep 0.1
    end
    rm -f $sock $view_file $current $shown
    set -q NIRI_SOCKET; and niri msg action unset-workspace-name $workspace 2>/dev/null
    return 0
end

# Every event ES-DE sends, for working out what it fires when (tmpfs, per boot).
echo (date +%T.%3N) $argv >>$XDG_RUNTIME_DIR/es-de-side.log

switch "$argv[1]"
    case start
        start
    case select
        select $argv[2..]
    case system
        system_select $argv[2..]
    case pause
        ipc set_property pause yes
        # game-start blocks the launch, so the watcher goes in the background.
        test -S $sock; and setsid -f $HOME/.local/bin/es-de-side watch >/dev/null 2>&1 </dev/null
    case watch
        watch_game
    case resume
        ipc set_property pause no
        # The game closing leaves focus on the preview; ES-DE needs it back.
        set -l esde (window_id es-de)
        test -n "$esde"; and niri msg action focus-window --id $esde
    case stop
        stop
    case '*'
        echo "usage: es-de-side start | select ROM NAME SYSTEM FULL | system SYSTEM FULL PATH | pause | resume | stop" >&2
        exit 2
end
